---
/**
 * ServiceDirectory.astro — every service, what it is, and a link to its page.
 *
 * Restores the clearest thing the original homepage did: it named all fourteen
 * services and said in one line what each one was for. The redesign had replaced
 * that with customer situations, which are good at "why would I call" but leave
 * "what do you actually offer" to be inferred. This states it.
 *
 * ─────────────────────────── Presentation ───────────────────────────
 *
 * NOT the original's four-column card grid. Fourteen equal cards was the single
 * most templated thing on the old homepage. This is a ruled two-column
 * directory: the service name carries display weight, its own tagline sits
 * beneath, and the whole row is the link. Same information, an eighth of the
 * visual noise.
 *
 * Names and blurbs come from services.ts, so adding a service to the catalogue
 * adds it here with no edit. The taglines are the original copy, unchanged.
 *
 * ────────────────────────── SEO and agentic ──────────────────────────
 *
 * This is the section that states, in plain crawlable HTML:
 *
 *     Load Logic -> junk removal services -> this service -> what it is -> its URL
 *
 * Fourteen anchors with descriptive text next to each. For an assistant asked
 * "what does Load Logic do", this is the answer in one block, and every entry
 * points at the page that holds the depth.
 */
import { services } from '../data/services';
import { serviceUrl } from '../lib/urls';

interface Props {
  /** Limit to specific service slugs. Omit for the full catalogue. */
  only?: string[];
  headingLevel?: 'h2' | 'h3';
}

const { only, headingLevel: Heading = 'h3' } = Astro.props;

const shown = only ? services.filter((s) => only.includes(s.slug)) : services;
---

<ol class="directory" data-reveal>
  {
    shown.map((service, i) => (
      <li>
        <a href={serviceUrl(service.slug)}>
          <span class="num data" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <Heading class="name">{service.name}</Heading>
          <span class="blurb">{service.tagline}</span>
          <span class="mark" aria-hidden="true">
            &#8594;
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  /* ─────────────────── An index, not a list of links ───────────────────
     Fourteen equal cards was the most templated thing on the old homepage. This
     is a contents page: a mono numeral, the service name at display weight, and
     its own line of description. The numbering is what does the work, because it
     turns fourteen separate links into one enumerated body of work.

     TWO COLUMNS above 900px. Fourteen full-width rows was legible but cost most
     of a screen; paired columns halve that without touching the content, and at
     roughly 600px per column the name and its description still both fit. */

  .directory {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .directory li {
    border-bottom: 1px solid var(--rule);
  }

  /* The whole row is the target, not just the name. On a phone that is the
     difference between a comfortable tap and a fiddly one. */
  .directory a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.25rem;
    grid-template-areas:
      'num name mark'
      'num blurb blurb';
    column-gap: var(--s3);
    align-items: baseline;
    padding-block: var(--s4);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur) var(--ease);
  }

  .num {
    grid-area: num;
    font-size: var(--t3);
    font-weight: 700;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur) var(--ease);
  }

  .name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--t1);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .blurb {
    grid-area: blurb;
    display: block;
    margin-top: var(--s1);
    font-size: var(--t3);
    color: var(--ink-2);
    max-width: 46ch;
  }

  /* One directional mark per row, held at low contrast until the row is the one
     being pointed at. */
  .mark {
    grid-area: mark;
    justify-self: end;
    color: var(--rule-strong);
    font-size: var(--t2);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .directory a:hover {
      background: var(--surface-alt-2);
    }

    .directory a:hover .num,
    .directory a:hover .mark {
      color: var(--ink);
    }

    .directory a:hover .mark {
      transform: translateX(3px);
    }
  }

  .directory a:focus-visible {
    outline: 2px solid var(--accent-press);
    outline-offset: -2px;
  }

  @media (min-width: 900px) {
    .directory {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s8);
    }

    /* Each column carries its own top rule so the two read as parallel indexes
       rather than as one list that happens to wrap. */
    .directory li:nth-child(-n + 2) {
      border-top: 0;
    }

    .directory a {
      grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
      column-gap: var(--s4);
      padding-block: var(--s4);
      padding-inline: var(--s3);
      margin-inline: calc(var(--s3) * -1);
    }

    .name {
      font-size: var(--d3);
    }
  }
</style>