---
/**
 * PricingLedger.astro — how a job is priced, without inventing a price.
 *
 * Real amounts are not available yet, so every figure stays behind
 * `published: false` in pricing.ts. That constraint is not a gap to apologise
 * for: explaining the pricing MODEL honestly is more useful to someone deciding
 * whether to call than a made-up "from $99" would be, and it is the difference
 * between a quote that holds and one that changes on the day.
 *
 * AGENTIC REQUIREMENT. This states what pricing is based on, what makes a job
 * bigger, what counts as a load, how heavy material differs, and how access
 * changes the number. Each factor is a real entity from pricing.ts, and the
 * access factors come from access.ts, so the same facts drive the quote form's
 * questions.
 *
 * Rendered as a hairline ledger rather than cards. Rules and space carry the
 * structure. A pricing explanation set in three rounded boxes reads as marketing;
 * set as a ledger it reads as a specification.
 *
 * TWO VARIANTS.
 *
 *   `summary`  the five things a visitor needs before they can judge whether to
 *              enquire: volume drives it, heavy material is different, access and
 *              labour matter, big jobs run as several loads, and the price is
 *              agreed before anything moves. Roughly a screen and a half.
 *
 *   `full`     every factor at depth, plus the access checklist and the load
 *              definitions. For service pages and a future pricing page.
 *
 * Both keep the same honesty contract: no amounts until real figures exist.
 */
import {
  primaryPricingFactors,
  pricingFactors,
  pricingTerms,
  isPricingPublished,
  formatPrice,
  publishedSurcharges,
  quotedSurcharges,
} from '../data/pricing';
import { pricingRelevantAccess } from '../data/access';
import { confirmedCapacityCubicYards, heavyMaterialVehicle, fleetLimits } from '../data/equipment';

interface Props {
  /**
   * `brief`    five rows and the minimum, roughly a screen. Homepage.
   * `summary`  the same five points with the surcharge list. 
   * `full`     every factor, the access checklist and the load definitions.
   */
  variant?: 'brief' | 'summary' | 'full';
  /**
   * Point keys to leave out. Set when this sits directly under the load size
   * scale, whose footer already states the minimum, the multiple-load rule and
   * the price-approval commitment. Repeating them two hundred pixels later is
   * the redundancy this prop exists to prevent.
   */
  omit?: PointKey[];
}

type PointKey = 'volume' | 'heavy' | 'access' | 'loads' | 'approve';

const { variant = 'full', omit = [] } = Astro.props;

const primary = primaryPricingFactors();
const secondary = pricingFactors.filter((f) => !f.primary);
const access = pricingRelevantAccess();
const capacity = confirmedCapacityCubicYards();
const dump = heavyMaterialVehicle();
const published = isPricingPublished();
const flatSurcharges = publishedSurcharges();
const quoted = quotedSurcharges();

/**
 * Sentences that interpolate an optional value are assembled here rather than in
 * the template. A JSX expression on its own line contributes the surrounding
 * whitespace, which renders as "the trailer filled , about 9 cubic yards".
 */
/**
 * The summary points, keyed so a caller can drop the ones its surrounding
 * context has already made.
 */
const allPoints: { key: PointKey; title: string; body: string }[] = [
  {
    key: 'volume',
    title: 'Volume first',
    body: 'Most of the price is the share of the trailer your items fill. The scale above is the fastest way to judge it yourself.',
  },
  {
    key: 'heavy',
    title: 'Heavy material is different',
    body: '', // filled below, it interpolates the confirmed dump trailer capacity
  },
  {
    key: 'access',
    title: 'Access and labour matter',
    body: 'Stairs, long carries from the door to the truck, tight gates and elevator buildings all add time. Mentioning them up front is what keeps a quote accurate.',
  },
  {
    key: 'loads',
    title: 'Big jobs are several loads',
    body: '', // filled below, it interpolates the confirmed trailer capacity
  },
  {
    key: 'approve',
    title: 'You approve the price first',
    body: 'The crew confirms the number on site and nothing is loaded until you agree to it. If there is more than expected, you decide before it goes on the trailer.',
  },
];

const fullLoadSentence = `One full load is the utility trailer filled${
  capacity ? `, about ${capacity} cubic yards` : ''
}. ${fleetLimits.consequence}`;

const heavySentence = `Concrete, tile, brick and soil are charged on weight rather than space, and they travel in the dump trailer${
  dump?.cubicYards ? ` (about ${dump.cubicYards} cubic yards)` : ''
}.`;

allPoints[1].body = heavySentence;
allPoints[3].body = fullLoadSentence;

const points = allPoints.filter((p) => !omit.includes(p.key));
---

{
  (variant === 'summary' || variant === 'brief') && (
    <div class="summary-ledger" data-reveal>
      <dl class="points">
        {points.map((point) => (
          <div class:list={['point', { emphasis: point.key === 'approve' }]}>
            <dt>{point.title}</dt>
            <dd>{point.body}</dd>
          </div>
        ))}
      </dl>

      {published && variant === 'brief' && (
        <p class="minimum brief-min">
          <strong>A few things carry their own disposal charge.</strong> Mattresses
          and box springs, anything containing refrigerant, and heavy material,
          because facilities charge separately for each. They are quoted with the
          job rather than added afterwards.
        </p>
      )}

      {published && variant === 'summary' ? (
        <div class="terms">
          <p class="minimum">
            <strong>Minimum {formatPrice(pricingTerms.minimum)}.</strong> Ranges
            cover normal access. The crew confirms the figure on site.
          </p>
          {flatSurcharges.length > 0 && (
            <ul class="surcharges">
              {flatSurcharges.map((sc) => (
                <li>
                  <span class="sc-name">{sc.name}</span>
                  <span class="sc-price data">{formatPrice(sc.price!)} each</span>
                </li>
              ))}
              {quoted.map((sc) => (
                <li>
                  <span class="sc-name">{sc.name}</span>
                  <span class="sc-price data">quoted from photos</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : !published ? (
        <p class="no-list">
          We quote per job rather than publishing a fixed list, because volume,
          weight and access vary too much for a list to be honest. Photos get you
          a real number before anyone arrives.
        </p>
      ) : null}
    </div>
  )
}

{
  variant === 'full' && (
    <div class="ledger" data-reveal>
  <!-- What the price is actually based on. Three inputs, weighted. -->
  <section class="block">
    <h3>What the price is based on</h3>
    <dl class="rows primary-rows">
      {
        primary.map((factor) => (
          <div class="row">
            <dt>{factor.name}</dt>
            <dd>{factor.explanation}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- What else moves the number. -->
  <section class="block">
    <h3>What else changes it</h3>
    <dl class="rows">
      {
        secondary.map((factor) => (
          <div class="row">
            <dt>{factor.name}</dt>
            <dd>{factor.explanation}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Access, which is the most commonly missed input and the usual reason a
       phone estimate turns out wrong. -->
  <section class="block">
    <h3>Access, and why we ask about it</h3>
    <p class="lede">
      Two identical sofas cost different amounts to remove if one is at the curb
      and the other is up two flights at the back of a gated complex. Telling us
      up front is what keeps a quote accurate.
    </p>
    <ul class="access">
      {
        access.map((factor) => (
          <li>
            <span class="access-name">{factor.name}</span>
            <span class="access-tell">{factor.tellUs}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Equipment facts that genuinely affect what a job costs and how it runs. -->
  <section class="block">
    <h3>What counts as a load</h3>
    <dl class="rows">
      <div class="row">
        <dt>One full load</dt>
        <dd>
          {`Our open utility trailer filled to the rails${
            capacity ? `, about ${capacity} cubic yards` : ''
          }. The load size scale above shows what each fraction of that looks like.`}
        </dd>
      </div>
      {
        dump && (
          <div class="row">
            <dt>Heavy material</dt>
            <dd>
              {`Dense debris like concrete, tile, brick and soil goes in the dump trailer${
                dump.cubicYards ? `, about ${dump.cubicYards} cubic yards` : ''
              }. It holds less volume but is built to carry the weight, and these loads are quoted on weight rather than on the space they take.`}
            </dd>
          </div>
        )
      }
      <div class="row">
        <dt>Bigger than one load</dt>
        <dd>{`${fleetLimits.consequence} ${fleetLimits.reason}`}</dd>
      </div>
      <div class="row">
        <dt>
          <span class="sc-label">Minimum</span>
          {published && <span class="dt-price data">{formatPrice(pricingTerms.minimum)}</span>}
        </dt>
        <dd>{pricingTerms.minimum.description}</dd>
      </div>
    </dl>
  </section>

  <!-- Charges that sit on top of the volume price. Stated up front, because
       these are the ones that otherwise turn into a driveway conversation. -->
  <section class="block">
    <h3>What gets added on top</h3>
    <dl class="rows">
      {
        pricingTerms.surcharges.map((sc) => (
          <div class="row">
            <dt>
              <span class="sc-label">{sc.name}</span>
              <span class="dt-price data">
                {sc.price?.published ? `${formatPrice(sc.price)} each` : 'quoted from photos'}
              </span>
            </dt>
            {/* `appliesTo` stays in the data for machine consumers but is not
                printed here: the heading already names the item and the price
                already says "each", so it read as a repeat. */}
            <dd>{sc.reason}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- The commitments. These are process promises, not numbers, so they are
       safe to state and they are what the customer actually wants to hear. -->
  <section class="block commitments">
    <h3>How the number is agreed</h3>
    <ul>
      {pricingTerms.commitments.map((c) => <li>{c}</li>)}
    </ul>
    {
      !published && (
        <p class="pending">
          We quote per job rather than publishing a fixed list, because volume,
          weight and access vary too much for a list to be honest. Photos get you
          a real number before anyone arrives.
        </p>
      )
    }
  </section>
    </div>
  )
}

<style>
  /* ─── summary variant ─── */

  .points {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .point {
    display: grid;
    gap: var(--s2);
    padding-block: var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  .point dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t1);
  }

  .point dd {
    margin: 0;
    color: var(--ink-2);
    max-width: 62ch;
  }

  /* The commitment is the one point that changes a decision, so it carries a
     hi-vis rule rather than another heading weight. */
  .emphasis {
    border-inline-start: 3px solid var(--hi-vis);
    padding-inline-start: var(--s4);
  }

  .emphasis dd {
    color: var(--ink);
  }

  .no-list {
    margin-top: var(--s5);
    font-size: var(--t3);
    color: var(--ink-2);
    max-width: 62ch;
  }

  .terms {
    margin-top: var(--s5);
    display: grid;
    gap: var(--s4);
  }

  .brief-min {
    margin-top: var(--s5);
    font-size: var(--t3);
  }

  .minimum {
    padding-inline-start: var(--s4);
    border-inline-start: 3px solid var(--hi-vis);
    max-width: 62ch;
    color: var(--ink-2);
  }

  .minimum strong {
    color: var(--ink);
  }

  .surcharges {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
    max-width: 40rem;
  }

  .surcharges li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--t3);
  }

  .sc-name {
    font-weight: 600;
  }

  .sc-price {
    color: var(--ink-2);
  }

  /* The figure sits under the label rather than inside the explanation, so a
     reader scanning for numbers finds them all in one column. */
  .sc-label {
    display: block;
  }

  .dt-price {
    display: block;
    margin-top: var(--s1);
    font-size: var(--t3);
    font-weight: 400;
    color: var(--ink-2);
  }

  /* ─── full variant ─── */

  .ledger {
    display: grid;
    gap: var(--s8);
  }

  h3 {
    font-size: var(--d3);
    padding-bottom: var(--s3);
    border-bottom: 2px solid var(--ink);
    margin-bottom: var(--s2);
  }

  .lede {
    margin-block: var(--s4);
    color: var(--ink-2);
    max-width: 60ch;
  }

  /* A hairline ledger: one rule under each row, never top and bottom both. */
  .rows {
    margin: 0;
  }

  .row {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  .row dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t2);
  }

  .row dd {
    margin: 0;
    color: var(--ink-2);
    max-width: 68ch;
  }

  /* The three primary inputs carry more weight than the rest. */
  .primary-rows .row dt {
    font-size: var(--t1);
  }

  .primary-rows .row dd {
    color: var(--ink);
  }

  .access {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .access li {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--rule);
  }

  .access-name {
    font-weight: 600;
  }

  .access-tell {
    font-size: var(--t3);
    color: var(--ink-2);
  }

  .commitments ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s3);
    margin-top: var(--s4);
  }

  .commitments li {
    padding-inline-start: var(--s5);
    position: relative;
    max-width: 62ch;
  }

  /* A short hi-vis rule as the marker. No check glyphs, no icon per line. */
  .commitments li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7em;
    width: 14px;
    height: 2px;
    background: var(--hi-vis);
  }

  .pending {
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
    font-size: var(--t3);
    color: var(--ink-2);
    max-width: 62ch;
  }

  @media (min-width: 768px) {
    .point {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      gap: var(--s6);
      align-items: baseline;
    }

    .row {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: var(--s6);
      align-items: baseline;
    }

    .access li {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: var(--s6);
      align-items: baseline;
    }
  }

  @media (min-width: 1100px) {
    .ledger {
      grid-template-columns: 1fr 1fr;
      gap: var(--s9) var(--s8);
    }

    /* The access block earns full width: it is the longest and the one most
       likely to change a quote. */
    .block:nth-child(3) {
      grid-column: 1 / -1;
    }
  }
</style>
