---
/**
 * Hero.astro — full-bleed photograph with the value proposition in a lower-left
 * well.
 *
 * This deliberately replaces the pattern the old site used, which was the
 * textbook generated hero: 135deg brand gradient, centred eyebrow, headline,
 * lead paragraph, two buttons and four translucent trust pills. DESIGN.md bans
 * every element of it.
 *
 * Stack discipline, per the anti-slop standard: at most four text elements. Here
 * that is location line, headline, one short subhead, and the CTA pair. No trust
 * pills, no micro-tagline under the buttons, no scroll cue. The trust content
 * lives in its own section directly below, where it can actually be read.
 *
 * The photograph is the hero. It loads eagerly at high priority because it is
 * the LCP element, and it carries a bottom-up near-black scrim so the copy stays
 * legible without tinting the image a brand colour.
 */
import { Image } from 'astro:assets';
import QuoteCta from './QuoteCta.astro';
import heroDesktop from '../assets/photos/home/hero-carry.jpg';
import heroMobile from '../assets/photos/home/hero-mobile.jpg';

interface Props {
  eyebrow: string;
  heading: string;
  subhead: string;
  /** Describes the work, never the company. See docs/image-art-direction.md. */
  alt: string;
}

const { eyebrow, heading, subhead, alt } = Astro.props;
---

<section class="hero">
  <div class="media">
    <Image
      class="img desktop"
      src={heroDesktop}
      {alt}
      widths={[900, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <Image
      class="img mobile"
      src={heroMobile}
      alt=""
      widths={[480, 780]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim"></div>
  </div>

  <div class="container container-wide well">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="subhead">{subhead}</p>
    <div class="actions">
      <QuoteCta size="lg" source="hero" onDark />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    /* dvh rather than vh: the iOS address bar must not shift the layout. */
    min-height: min(78dvh, 720px);
    align-content: end;
    isolation: isolate;
    background: var(--spruce);
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .desktop {
    display: none;
    object-position: center 42%;
  }

  .mobile {
    display: block;
    object-position: center center;
  }

  /* Near-black bottom-up ramp, never a brand-coloured wash.
     Two layers: a vertical ramp for the copy block, plus a left-weighted wash so
     the eyebrow and headline stay legible even where the photograph is bright,
     which at some widths lands on open sky. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(8 14 11 / 0.62) 0%,
        rgb(8 14 11 / 0.34) 42%,
        rgb(8 14 11 / 0) 78%
      ),
      linear-gradient(
        to top,
        rgb(8 14 11 / 0.92) 0%,
        rgb(8 14 11 / 0.74) 34%,
        rgb(8 14 11 / 0.28) 68%,
        rgb(8 14 11 / 0.12) 100%
      );
  }

  .well {
    padding-block: var(--s8) var(--s9);
    color: #fff;
    max-width: var(--w-wide);
  }

  .eyebrow {
    font-size: var(--lbl);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--hi-vis);
    margin-bottom: var(--s4);
  }

  h1 {
    color: #fff;
    max-width: 16ch;
  }

  .subhead {
    margin-top: var(--s5);
    font-size: var(--t1);
    color: rgb(255 255 255 / 0.86);
    max-width: 46ch;
  }

  .actions {
    margin-top: var(--s6);
  }

  @media (min-width: 768px) {
    .desktop {
      display: block;
    }

    .mobile {
      display: none;
    }

    .well {
      padding-block: var(--s9) var(--s10);
    }
  }
</style>
