---
/**
 * Hero.astro — art-directed photograph, then the message on solid ground.
 *
 * ─────────────────────────── Composition ───────────────────────────
 *
 * The photograph runs full width and carries no text at all. Underneath it a
 * spruce block holds the message in two facing columns: the headline on the
 * left, the supporting line and both conversion actions on the right, with a
 * hi-vis rule marking the join. Keeping type off the photograph is the point —
 * the headline can be set at display size without fighting photographic detail,
 * and no generated subject ever sits behind text.
 *
 * ──────────────────── Responsive art direction ────────────────────
 *
 * TWO SOURCES, NOT ONE CROP. A 16:9 frame letterboxed into a phone leaves a hero
 * whose subject is a strip of driveway. The wide frame carries the environment —
 * house, driveway, truck and loaded trailer in context — and the tall frame
 * moves in on the loaded trailer itself. Two compositions of one scene, not two
 * crops of one file.
 *
 * Served through a real <picture> with a `media` source rather than two <img>
 * elements toggled with display:none. The toggle is what this component used
 * before and it wastes bandwidth: browsers fetch both, so every phone was
 * downloading a desktop hero it would never display. getImage() builds the
 * optimised srcset for each source and the browser fetches exactly one.
 *
 * The <img> is the LCP element: eager, high fetchpriority, explicit dimensions
 * so its box is reserved before it loads.
 */
import { getImage } from 'astro:assets';
import QuoteCta from './QuoteCta.astro';
import heroWide from '../assets/photos/home/hero-drive-wide.jpg';
import heroTall from '../assets/photos/home/hero-drive-tall.jpg';

interface Props {
  eyebrow: string;
  heading: string;
  subhead: string;
  /** Describes the work, never the company. See docs/image-art-direction.md. */
  alt: string;
  /** Operating data. Every value must be a real, checkable fact. */
  facts: { label: string; value: string }[];
}

const { eyebrow, heading, subhead, alt, facts } = Astro.props;

const wide = await getImage({
  src: heroWide,
  widths: [960, 1440, 1920],
  format: 'webp',
});
const tall = await getImage({
  src: heroTall,
  widths: [480, 780, 960],
  format: 'webp',
});
---

<section class="hero">
  <div class="media">
    <picture>
      <source media="(min-width: 768px)" srcset={wide.srcSet.attribute} sizes="100vw" />
      <img
        src={tall.src}
        srcset={tall.srcSet.attribute}
        sizes="100vw"
        {alt}
        width={tall.attributes.width}
        height={tall.attributes.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="block">
    <div class="container container-wide inner">
      <div class="say">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
      </div>

      <div class="act">
        <p class="subhead">{subhead}</p>
        <QuoteCta size="lg" source="hero" onDark />
        <dl class="facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd class="data">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--spruce);
  }

  /* ─── Photograph ─── */

  .media img {
    display: block;
    width: 100%;
    /* dvh rather than vh: the iOS address bar must not resize the crop. */
    height: min(54dvh, 400px);
    object-fit: cover;
    object-position: center 56%;
  }

  /* ─── Message ─── */

  .block {
    border-top: 4px solid var(--hi-vis);
    padding-block: var(--s7) var(--s8);
    color: var(--on-spruce);
  }

  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--hi-vis);
    margin-bottom: var(--s4);
  }

  h1 {
    color: #fff;
    font-size: var(--d0);
    letter-spacing: -0.035em;
    line-height: 0.94;
    max-width: 14ch;
  }

  .subhead {
    font-size: var(--t1);
    color: rgb(255 255 255 / 0.82);
    max-width: 42ch;
    margin-bottom: var(--s6);
  }

  .act {
    margin-top: var(--s6);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s4) var(--s6);
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule-on-spruce);
  }

  .facts dt {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-spruce-2);
  }

  .facts dd {
    margin-top: var(--s1);
    font-size: var(--t2);
    font-weight: 700;
    color: #fff;
  }

  @media (min-width: 768px) {
    .media img {
      height: min(58dvh, 540px);
      object-position: center 54%;
    }
  }

  /* The two facing columns. Below this the block is one stack, which is the
     right answer on a phone: headline, the line that supports it, then the
     action, in reading order. */
  @media (min-width: 900px) {
    .inner {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s9);
      align-items: end;
    }

    .act {
      margin-top: 0;
    }

    .facts {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: var(--s6);
    }
  }
</style>
