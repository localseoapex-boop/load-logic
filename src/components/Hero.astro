---
/**
 * Hero.astro — photograph above, type in a spruce panel that overlaps it.
 *
 * ────────────────────────── Why this was rebuilt ──────────────────────────
 *
 * The previous hero was a full-bleed photograph with the copy in a lower-left
 * well over a scrim. Nothing about it was wrong, and that was the problem: it is
 * the composition every competently built site arrives at, so it read as correct
 * rather than as designed. It also forced the headline to stay small enough to
 * survive being set over photographic detail, which capped the single biggest
 * piece of typography on the page.
 *
 * Now the photograph gets to be a photograph and the type gets solid ground:
 *
 *   - the image runs full-bleed with a deliberate crop and no text on it
 *   - a spruce panel is pulled UP over the image's lower edge, so the two
 *     elements interlock instead of stacking, and the panel breaks the
 *     photograph's rectangle rather than sitting politely beneath it
 *   - on solid spruce the headline can run at --d0, roughly 112px at 1440,
 *     which is the scale the page was missing
 *   - a hi-vis edge marks the top of the panel; it is the accent doing
 *     structural work, not decoration
 *   - a mono data rail closes the hero with the operating facts a dispatcher
 *     would actually state: where, how big, how fast, what number to call
 *
 * The image still loads eagerly at high priority because it remains the LCP
 * element. The scrim is gone: with no copy over the photograph there is nothing
 * to protect, and dropping it means the image is seen at full contrast.
 */
import { Image } from 'astro:assets';
import QuoteCta from './QuoteCta.astro';
import heroDesktop from '../assets/photos/home/hero-carry.jpg';
import heroMobile from '../assets/photos/home/hero-mobile.jpg';

interface Props {
  eyebrow: string;
  heading: string;
  subhead: string;
  /** Describes the work, never the company. See docs/image-art-direction.md. */
  alt: string;
  /**
   * Alt for the small-screen crop. It needs its own, not an empty string: the
   * desktop image is display:none below 768px, which removes it from the
   * accessibility tree, so this is the only hero image a mobile screen reader
   * ever sees. Leaving it decorative meant mobile users got no description at
   * all.
   */
  mobileAlt: string;
  /** Operating data for the rail. Every value must be a real, checkable fact. */
  facts: { label: string; value: string }[];
}

const { eyebrow, heading, subhead, alt, mobileAlt, facts } = Astro.props;
---

<section class="hero">
  <div class="media">
    <Image
      class="img desktop"
      src={heroDesktop}
      {alt}
      widths={[900, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <Image
      class="img mobile"
      src={heroMobile}
      alt={mobileAlt}
      widths={[480, 780]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container container-wide">
    <div class="panel">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="subhead">{subhead}</p>
      <div class="actions">
        <QuoteCta size="lg" source="hero" onDark />
      </div>
    </div>
  </div>

  <div class="rail">
    <div class="container container-wide">
      <dl>
        {
          facts.map((fact) => (
            <div class="fact">
              <dt>{fact.label}</dt>
              <dd class="data">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--spruce);
    isolation: isolate;
  }

  /* ─── Photograph ─── */

  .media {
    position: relative;
  }

  .img {
    width: 100%;
    /* dvh rather than vh: the iOS address bar must not resize the crop. */
    height: min(52dvh, 460px);
    object-fit: cover;
    display: block;
  }

  .desktop {
    display: none;
    object-position: center 40%;
  }

  .mobile {
    display: block;
    object-position: center 45%;
  }

  /* ─── The panel that breaks the photograph ─── */

  .panel {
    position: relative;
    /* The overlap. This is the whole composition: pull the panel up over the
       image so the two interlock rather than stack. */
    margin-top: calc(var(--s8) * -1);
    background: var(--spruce);
    padding: var(--s7) var(--s6) var(--s7);
    /* Bleeds past the container gutter to the viewport edge on small screens,
       where a floating panel would waste width it cannot spare. */
    margin-inline: calc(var(--gutter) * -1);
    border-top: 4px solid var(--hi-vis);
  }

  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--hi-vis);
    margin-bottom: var(--s5);
  }

  h1 {
    color: #fff;
    font-size: var(--d0);
    letter-spacing: -0.035em;
    line-height: 0.92;
    max-width: 15ch;
  }

  .subhead {
    margin-top: var(--s5);
    font-size: var(--t1);
    color: rgb(255 255 255 / 0.84);
    max-width: 48ch;
  }

  .actions {
    margin-top: var(--s6);
  }

  /* ─── Operating data rail ─── */

  .rail {
    border-top: 1px solid var(--rule-on-spruce);
    padding-block: var(--s5);
  }

  .rail dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s5) var(--s6);
  }

  .fact dt {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-spruce-2);
  }

  .fact dd {
    margin-top: var(--s2);
    font-size: var(--t2);
    font-weight: 700;
    color: #fff;
  }

  @media (min-width: 768px) {
    .desktop {
      display: block;
    }

    .mobile {
      display: none;
    }

    .img {
      height: min(62dvh, 600px);
    }

    /* At desktop the panel becomes a measured block anchored to the container's
       left edge. It does not need to bleed to the viewport: the photograph
       already runs full width, so a contained panel pulled up over it is itself
       the break in the rectangle. Roughly the left 55% is type, the right 45%
       stays photograph, which is where the asymmetry comes from. */
    .panel {
      margin-top: calc(var(--s10) * -1);
      /* Bleed left to the viewport edge. Contained, the panel left a narrow
         strip of photograph down its outer side that read as a mistake rather
         than as a margin. Running it off the edge is also the stronger move:
         the block breaks the content column instead of sitting inside it.
         50% resolves against the centred container, so 50% - 50vw is exactly
         the distance from the container's content edge to the viewport. */
      margin-inline-start: calc(50% - 50vw);
      margin-inline-end: 0;
      padding: var(--s8);
      padding-inline-start: calc(50vw - 50% + var(--s2));
      width: calc(50vw - 50% + min(60%, 46rem));
    }

    .rail dl {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s6);
    }

    .rail {
      padding-block: var(--s6);
    }
  }
</style>
