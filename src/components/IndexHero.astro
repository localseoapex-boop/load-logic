---
/**
 * IndexHero.astro — the compact masthead for index/resource pages.
 *
 * Used by /services, /locations, /pricing and /blog. Deliberately NOT the
 * conversion hero the homepage, city pages and service pages use, and the
 * differences are the point — a visitor should read these as higher-level
 * hub pages at a glance:
 *
 *   height     ~380px desktop / ~300px mobile, roughly a third to a half of
 *              the primary heroes (which run to min(66dvh, 540px) and taller)
 *   image      ONE full-bleed background photograph at every width — no split
 *              treatment, and no photo-band-plus-copy-block on mobile. The
 *              mobile split belongs to the primary hero family only.
 *   overlay    heavier and simpler than the primary heroes: a flat darkening
 *              layer plus one left gradient, because the copy is short and
 *              sits in the left third at every width
 *   type       H1 at --d2 rather than --d1, one short lede, no promise boxes,
 *              no floating modules, no pricing UI
 *   rule       the hi-vis bottom rule marks the band as a masthead, the same
 *              accent the primary heroes carry
 *
 * The CTA is optional and restrained: pages whose job is browsing (services,
 * locations, blog) pass none, and the section content carries the links.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import QuoteCta from './QuoteCta.astro';

interface Props {
  /** Short mono kicker above the H1, e.g. "Pricing". */
  eyebrow?: string;
  /** The page's ONE h1. */
  heading: string;
  /** One or two short supporting sentences. */
  lede?: string;
  /** Full-bleed background photograph. Decorative: alt is always empty. */
  image: ImageMetadata;
  /** object-position for the cover crop, per page. */
  focus?: string;
  /** Render the site's standard quote CTA pair, tagged with this source. */
  ctaSource?: string;
}

const { eyebrow, heading, lede, image, focus = 'center 50%', ctaSource } = Astro.props;

const bg = await getImage({
  src: image,
  widths: [768, 1024],
  format: 'webp',
});
---

<header class="index-hero" style={`--hero-focus: ${focus}`}>
  <div class="media" aria-hidden="true">
    <img
      src={bg.src}
      srcset={bg.srcSet.attribute}
      sizes="100vw"
      alt=""
      width={bg.attributes.width}
      height={bg.attributes.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="shade"></div>
  </div>

  <div class="container container-wide inner">
    {eyebrow && <p class="eyebrow data">{eyebrow}</p>}
    <h1>{heading}</h1>
    {lede && <p class="lede">{lede}</p>}
    {
      ctaSource && (
        <div class="cta">
          <QuoteCta source={ctaSource} onDark />
        </div>
      )
    }
  </div>
</header>

<style>
  .index-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 380px;
    isolation: isolate;
    background: var(--dark);
    color: #fff;
    border-bottom: 3px solid var(--accent);
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-focus, center 50%);
  }

  /* One flat layer for base contrast, one left gradient under the copy. The
     primary heroes run lighter dual gradients; this band is short and the copy
     always sits left, so the overlay commits harder and stays simple. */
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(24 26 28 / 0.86) 0%,
        rgb(24 26 28 / 0.66) 38%,
        rgb(24 26 28 / 0.3) 68%,
        rgb(24 26 28 / 0.14) 100%
      ),
      rgb(24 26 28 / 0.18);
  }

  .inner {
    position: relative;
    z-index: 1;
    padding-block: var(--s7);
  }

  .eyebrow {
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: var(--s3);
  }

  /* --d2, not --d1: a masthead, not the primary hero statement. */
  h1 {
    font-size: var(--d2);
    letter-spacing: 0;
    line-height: 1;
    max-width: 18ch;
    color: #fff;
    text-shadow: 0 2px 20px rgb(24 26 28 / 0.45);
  }

  .lede {
    margin-top: var(--s4);
    font-size: var(--t2);
    color: rgb(255 255 255 / 0.92);
    max-width: 52ch;
    text-wrap: pretty;
    text-shadow: 0 1px 14px rgb(24 26 28 / 0.5);
  }

  .cta {
    margin-top: var(--s5);
  }

  /* The transparent secondary button is too weak over a photograph; same
     scoped strengthening the city hero uses. */
  .cta :global(.btn.dark.solid) {
    background: rgb(24 26 28 / 0.55);
    border-color: rgb(255 255 255 / 0.5);
    color: #fff;
  }

  .cta :global(.btn.dark.solid:hover) {
    background: rgb(24 26 28 / 0.74);
    border-color: #fff;
  }

  @media (max-width: 767px) {
    .index-hero {
      min-height: 300px;
    }

    .inner {
      padding-block: var(--s5);
    }

    .lede {
      margin-top: var(--s3);
    }

    .cta {
      margin-top: var(--s4);
    }

    /* On a phone the sticky conversion bar already shows Call Now full-time,
       so the masthead keeps only the primary quote action. Two stacked buttons
       plus the bar would mean three CTAs in one viewport and a band well past
       the compact height this component exists for. */
    .cta :global(.btn.dark.solid) {
      display: none;
    }
  }
</style>
