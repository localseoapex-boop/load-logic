---
/**
 * SiteFooter.astro — NAP per office, navigation, and the closing phone action.
 *
 * Iterates offices.ts so every physical location shows its own address and phone
 * in a semantic <address> element. This mirrors the multi-node LocalBusiness
 * schema exactly, and consistent NAP across page, schema and external listings
 * is a core local-SEO ranking factor. That behaviour is preserved from the old
 * footer; only the presentation changed.
 *
 * Service links are generated from the catalogue rather than hardcoded, so a new
 * service appears here automatically.
 */
import { SITE, BUSINESS, FOOTER_LINKS } from '../config/site';
import { offices } from '../data/offices';
import { serviceAreaLocations } from '../lib/links';
import { cityUrl } from '../lib/urls';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const areas = serviceAreaLocations;
---

<footer class="site-footer on-dark">
  <div class="container container-wide inner">
    <div class="brand-col">
      <a class="brand" href="/">
        <BrandMark size={32} onDark />
        <span class="wordmark">Load Logic</span>
      </a>
      <p class="tagline">{SITE.description}</p>
    </div>

    {
      offices.map((office) => (
        <div class="col">
          <p class="heading">{office.name}</p>
          <address>
            {office.address.street && (
              <>
                {office.address.street}
                <br />
              </>
            )}
            {office.address.city}, {office.address.region}
            {office.address.postalCode ? ` ${office.address.postalCode}` : ''}
            <br />
            <a class="data phone" href={`tel:${office.phone}`}>
              {BUSINESS.phoneDisplay}
            </a>
          </address>
        </div>
      ))
    }

    {
      FOOTER_LINKS.map((group) => (
        <nav class="col" aria-label={group.title}>
          <p class="heading">{group.title}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <nav class="col" aria-label="Areas we serve">
      <p class="heading">Areas we serve</p>
      <ul class="areas">
        {areas.map((loc) => <li><a href={cityUrl(loc.slug)}>{loc.city}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container container-wide legal">
    <p>&copy; {year} {offices[0].legalName}. All rights reserved.</p>
    <p class="mesa">Based in Mesa, Arizona. Serving the East Valley.</p>
  </div>
</footer>

<style>
  .site-footer {
    /* Near black: the darkest surface on the site. The closing CTA above is
       charcoal, so the footer reads as its own deeper block; the hairline
       keeps a legible boundary between the two dark regions. */
    background: var(--dark-deep);
    color: var(--on-dark-2);
    font-size: var(--t3);
    border-top: 1px solid var(--rule-on-dark);
  }

  /*
   * The width is restated here because legacy.css also defines `.container`, at
   * the same specificity, and it is loaded after the base stylesheet on the
   * templates that still use it. That capped the footer at the old 1100px with
   * 16px gutters. Scoping these to `.inner` and `.legal` wins on specificity
   * without changing the global container for anyone else.
   */
  .inner {
    max-width: var(--w-wide);
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s7) var(--s6);
    padding-block: var(--s8) var(--s7);
  }

  .brand-col {
    grid-column: 1 / -1;
    max-width: 42ch;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    text-decoration: none;
    margin-bottom: var(--s4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    color: #fff;
  }

  .tagline {
    line-height: 1.6;
  }

  .heading {
    font-family: var(--font-display);
    font-size: var(--lbl);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: #fff;
    margin-bottom: var(--s4);
  }

  address {
    font-style: normal;
    line-height: 1.8;
  }

  .phone {
    font-weight: 600;
    color: #fff;
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s2);
  }

  .areas {
    grid-template-columns: 1fr 1fr;
    gap: var(--s2) var(--s4);
  }

  .site-footer a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .legal {
    max-width: var(--w-wide);
    padding-inline: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3);
    padding-block: var(--s5) var(--s7);
    border-top: 1px solid var(--rule-on-dark);
    font-size: var(--lbl);
    letter-spacing: 0.02em;
  }

  .mesa {
    color: var(--on-dark-2);
  }

  @media (min-width: 768px) {
    .brand-col {
      grid-column: span 2;
    }
  }
</style>
