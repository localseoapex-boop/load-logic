---
/**
 * SiteHeader.astro — brand, navigation directories, and conversion actions.
 *
 * MOBILE IS THE POINT HERE. The old header stacked into three rows and consumed
 * 170px before the hero began, on the device most visitors arrive with. This one
 * is a single 64px bar at every width: mark and wordmark left, "Call Now" and a
 * menu trigger right. Nav links move into a disclosure panel.
 *
 * The outer mobile panel remains a native <details> element. Small scripts add
 * mutually exclusive subdirectories, desktop disclosure controls, Escape focus
 * restoration, and viewport scroll containment.
 *
 * Links come from NAV_LINKS so the menu is edited in one place, and the active
 * link is marked with aria-current for both users and crawlers.
 */
import { SITE, BUSINESS, NAV_LINKS } from '../config/site';
import { getService, type Service } from '../data/services';
import { primaryQuoteAction } from '../data/quote-actions';
import { serviceAreaLocations } from '../lib/links';
import { cityUrl, serviceUrl } from '../lib/urls';
import Button from './Button.astro';
import BrandMark from './BrandMark.astro';

const currentPath = Astro.url.pathname;
const quote = primaryQuoteAction();

const normalizePath = (href: string) => href === '/' ? href : href.replace(/\/$/, '');
const isExact = (href: string) => normalizePath(currentPath) === normalizePath(href);
const isSectionActive = (href: string) =>
  href !== '/' && (isExact(href) || currentPath.startsWith(`${normalizePath(href)}/`));

const resolveServices = (slugs: string[]): Service[] =>
  slugs.map((slug) => getService(slug)).filter((service): service is Service => Boolean(service));

/** Presentational groups only. Every item retains its canonical /services/* URL. */
const serviceGroups = [
  {
    label: 'Full-service removal',
    services: resolveServices([
      'junk-removal',
      'furniture-removal',
      'appliance-removal',
      'mattress-removal',
      'same-day-junk-removal',
    ]),
  },
  {
    label: 'Property cleanouts',
    services: resolveServices([
      'garage-cleanouts',
      'estate-cleanouts',
      'hoarder-cleanouts',
      'office-cleanouts',
      'foreclosure-cleanouts',
    ]),
  },
  {
    label: 'Outdoor & project work',
    services: resolveServices([
      'hot-tub-removal',
      'construction-debris-removal',
      'yard-waste-removal',
      'shed-removal',
    ]),
  },
] as const;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <BrandMark size={30} />
      <span class="wordmark">Load Logic</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="primary-links">
        {
          NAV_LINKS.map((link) => {
            const dropdown = link.href === '/services' ? 'services' : link.href === '/locations' ? 'areas' : undefined;
            const panelId = dropdown ? `${dropdown}-desktop-panel` : undefined;

            return (
              <li class:list={['nav-item', { 'has-dropdown': dropdown }]} data-desktop-dropdown={dropdown}>
                <div class="nav-link-row">
                  <a
                    class:list={{ 'section-active': isSectionActive(link.href) }}
                    href={link.href}
                    aria-current={isExact(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                  {dropdown && (
                    <button
                      class="dropdown-toggle"
                      type="button"
                      aria-label={`Toggle ${link.label} links`}
                      aria-expanded="false"
                      aria-controls={panelId}
                    >
                      <span class="chevron" aria-hidden="true"></span>
                    </button>
                  )}
                </div>

                {dropdown === 'services' && (
                  <div id={panelId} class="dropdown-panel services-dropdown" hidden>
                    <div class="service-columns">
                      {serviceGroups.map((group, groupIndex) => (
                        <section class="directory-group" aria-labelledby={`desktop-service-group-${groupIndex}`}>
                          <p class="directory-label" id={`desktop-service-group-${groupIndex}`}>{group.label}</p>
                          <ul class="directory-list">
                            {group.services.map((service) => (
                              <li>
                                <a href={serviceUrl(service.slug)} aria-current={isExact(serviceUrl(service.slug)) ? 'page' : undefined}>
                                  {service.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))}
                    </div>
                    <a class="directory-footer" href="/services" aria-current={isExact('/services') ? 'page' : undefined}>
                      View All Services <span aria-hidden="true">→</span>
                    </a>
                  </div>
                )}

                {dropdown === 'areas' && (
                  <div id={panelId} class="dropdown-panel areas-dropdown" hidden>
                    <a class="mesa-link" href="/" aria-current={isExact('/') ? 'page' : undefined}>
                      <span>Mesa, AZ</span>
                      <span class="home-base">Home Base</span>
                    </a>
                    <ul class="city-directory">
                      {serviceAreaLocations.map((location) => (
                        <li>
                          <a href={cityUrl(location.slug)} aria-current={isExact(cityUrl(location.slug)) ? 'page' : undefined}>
                            {location.city}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a class="directory-footer" href="/locations" aria-current={isExact('/locations') ? 'page' : undefined}>
                      View All Areas <span aria-hidden="true">→</span>
                    </a>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={`tel:${BUSINESS.phone}`}>
        <span class="phone-label">Call Now</span>
        <span class="phone-number data">{BUSINESS.phoneDisplay}</span>
      </a>
      <div class="quote-btn">
        <Button href={quote.href} variant="primary">{quote.label}</Button>
      </div>

      <details class="menu">
        <summary aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu-panel">
          <span class="bars" aria-hidden="true"></span>
          <span class="menu-text">Menu</span>
        </summary>
        <div class="panel" id="mobile-menu-panel">
          <div class="panel-scroll">
            <nav aria-label="Primary mobile">
              <ul class="mobile-primary-links">
                <li><a href="/" aria-current={isExact('/') ? 'page' : undefined}>Home</a></li>

                <li class="mobile-group" data-mobile-group>
                  <div class="mobile-group-row">
                    <a class:list={{ 'section-active': isSectionActive('/services') }} href="/services" aria-current={isExact('/services') ? 'page' : undefined}>Services</a>
                    <button type="button" aria-label="Toggle Services links" aria-expanded="false" aria-controls="services-mobile-panel">
                      <span class="chevron" aria-hidden="true"></span>
                    </button>
                  </div>
                  <div class="mobile-subpanel" id="services-mobile-panel" hidden>
                    {serviceGroups.map((group, groupIndex) => (
                      <section class="mobile-directory-group" aria-labelledby={`mobile-service-group-${groupIndex}`}>
                        <p class="directory-label" id={`mobile-service-group-${groupIndex}`}>{group.label}</p>
                        <ul class="mobile-directory-list">
                          {group.services.map((service) => (
                            <li>
                              <a href={serviceUrl(service.slug)} aria-current={isExact(serviceUrl(service.slug)) ? 'page' : undefined}>{service.name}</a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    ))}
                    <a class="mobile-view-all" href="/services" aria-current={isExact('/services') ? 'page' : undefined}>
                      View All Services <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>

                <li><a href="/pricing" aria-current={isExact('/pricing') ? 'page' : undefined}>Pricing</a></li>

                <li class="mobile-group" data-mobile-group>
                  <div class="mobile-group-row">
                    <a class:list={{ 'section-active': isSectionActive('/locations') }} href="/locations" aria-current={isExact('/locations') ? 'page' : undefined}>Areas We Serve</a>
                    <button type="button" aria-label="Toggle Areas We Serve links" aria-expanded="false" aria-controls="areas-mobile-panel">
                      <span class="chevron" aria-hidden="true"></span>
                    </button>
                  </div>
                  <div class="mobile-subpanel" id="areas-mobile-panel" hidden>
                    <a class="mobile-mesa-link" href="/" aria-current={isExact('/') ? 'page' : undefined}>
                      <span>Mesa, AZ</span>
                      <span class="home-base">Home Base</span>
                    </a>
                    <ul class="mobile-directory-list">
                      {serviceAreaLocations.map((location) => (
                        <li>
                          <a href={cityUrl(location.slug)} aria-current={isExact(cityUrl(location.slug)) ? 'page' : undefined}>{location.city}</a>
                        </li>
                      ))}
                    </ul>
                    <a class="mobile-view-all" href="/locations" aria-current={isExact('/locations') ? 'page' : undefined}>
                      View All Areas <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>

                <li><a href="/blog" aria-current={isExact('/blog') ? 'page' : undefined}>Blog</a></li>
              </ul>
            </nav>
            <div class="tablet-quote">
              <Button href={quote.href} variant="primary" full>{quote.label}</Button>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const desktopDropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-desktop-dropdown]'));

  const closeDesktopDropdown = (item: HTMLElement) => {
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
    const panel = item.querySelector<HTMLElement>('.dropdown-panel');
    if (!toggle || !panel) return;
    item.classList.remove('is-open');
    delete item.dataset.pinned;
    toggle.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
  };

  const openDesktopDropdown = (item: HTMLElement, pinned = false) => {
    desktopDropdowns.forEach((other) => {
      if (other !== item) closeDesktopDropdown(other);
    });
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
    const panel = item.querySelector<HTMLElement>('.dropdown-panel');
    if (!toggle || !panel) return;
    item.classList.add('is-open');
    if (pinned) item.dataset.pinned = 'true';
    toggle.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
  };

  desktopDropdowns.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
    let closeTimer: number | undefined;
    const cancelClose = () => closeTimer && window.clearTimeout(closeTimer);
    const scheduleClose = () => {
      cancelClose();
      if (item.dataset.pinned === 'true') return;
      closeTimer = window.setTimeout(() => closeDesktopDropdown(item), 180);
    };

    item.addEventListener('pointerenter', () => {
      cancelClose();
      openDesktopDropdown(item, item.dataset.pinned === 'true');
    });
    item.addEventListener('pointerleave', scheduleClose);
    item.addEventListener('focusin', () => {
      cancelClose();
      openDesktopDropdown(item, item.dataset.pinned === 'true');
    });
    item.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!item.contains(document.activeElement)) closeDesktopDropdown(item);
      });
    });
    toggle?.addEventListener('click', () => {
      if (item.dataset.pinned === 'true') closeDesktopDropdown(item);
      else openDesktopDropdown(item, true);
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    desktopDropdowns.forEach((item) => {
      if (!item.contains(event.target)) closeDesktopDropdown(item);
    });
  });

  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mobileGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-group]'));

  const closeMobileGroup = (group: HTMLElement) => {
    const toggle = group.querySelector<HTMLButtonElement>('.mobile-group-row button');
    const panel = group.querySelector<HTMLElement>('.mobile-subpanel');
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
  };

  mobileGroups.forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>('.mobile-group-row button');
    const panel = group.querySelector<HTMLElement>('.mobile-subpanel');
    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const shouldOpen = panel.hidden;
      mobileGroups.forEach(closeMobileGroup);
      if (shouldOpen) {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  const closeMobileMenu = (restoreFocus = false) => {
    if (!menu) return;
    menu.open = false;
    mobileGroups.forEach(closeMobileGroup);
    document.body.classList.remove('nav-open');
    const summary = menu.querySelector<HTMLElement>(':scope > summary');
    summary?.setAttribute('aria-expanded', 'false');
    if (restoreFocus) summary?.focus();
  };

  if (menu) {
    menu.addEventListener('toggle', () => {
      const summary = menu.querySelector<HTMLElement>(':scope > summary');
      summary?.setAttribute('aria-expanded', String(menu.open));
      document.body.classList.toggle('nav-open', menu.open);
      if (!menu.open) mobileGroups.forEach(closeMobileGroup);
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMobileMenu();
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    const openDesktop = desktopDropdowns.find((item) => item.classList.contains('is-open'));
    if (openDesktop) {
      const toggle = openDesktop.querySelector<HTMLButtonElement>('.dropdown-toggle');
      /* Move focus while the panel still exists, then close it. Focusing the
         toggle first intentionally lets focusin run before the final close. */
      toggle?.focus();
      closeDesktopDropdown(openDesktop);
      return;
    }

    if (menu?.open) closeMobileMenu(true);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    width: 100%;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--s6);
  }

  /* ─── Brand ─── */

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s3);
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }

  /* ─── Desktop nav ─── */

  .desktop-nav {
    display: none;
  }

  .primary-links {
    display: flex;
    align-items: center;
    gap: var(--s6);
    list-style: none;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link-row {
    display: flex;
    align-items: center;
  }

  .desktop-nav .nav-link-row > a {
    font-size: var(--t3);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: var(--s2);
    white-space: nowrap;
  }

  .desktop-nav .nav-link-row > a:hover,
  .desktop-nav .nav-link-row > a.section-active,
  .desktop-nav .nav-link-row > a[aria-current='page'] {
    color: var(--ink);
  }

  .desktop-nav .nav-link-row > a.section-active,
  .desktop-nav .nav-link-row > a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .dropdown-toggle {
    width: 28px;
    height: 36px;
    display: inline-grid;
    place-items: center;
    margin-inline-end: -8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }

  .chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform var(--dur) var(--ease);
  }

  [aria-expanded='true'] .chevron {
    transform: rotate(225deg) translate(-1px, -1px);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 14px);
    z-index: var(--z-overlay);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    box-shadow: var(--shadow-lift);
  }

  /* Bridges the visual gap so moving from trigger to panel does not close it. */
  .dropdown-panel::before {
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: 15px;
    content: '';
  }

  .services-dropdown {
    left: calc(-1 * var(--s9));
    width: min(780px, calc(100vw - (2 * var(--gutter))));
    padding: var(--s5) var(--s5) 0;
  }

  .service-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s6);
    padding-bottom: var(--s5);
  }

  .areas-dropdown {
    left: -200px;
    width: min(520px, calc(100vw - (2 * var(--gutter))));
    padding: var(--s5) var(--s5) 0;
  }

  .directory-label {
    margin-bottom: var(--s3);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--lbl);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .directory-list,
  .city-directory {
    display: grid;
    list-style: none;
    padding: 0;
  }

  .directory-list li + li,
  .city-directory li:nth-child(n + 3) {
    border-top: 1px solid var(--rule);
  }

  .directory-list a,
  .city-directory a {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--ink);
    font-size: var(--t3);
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
  }

  .directory-list a:hover,
  .city-directory a:hover,
  .directory-list a[aria-current='page'],
  .city-directory a[aria-current='page'] {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .mesa-link {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s3);
    padding: 0 var(--s3);
    background: var(--surface-alt-2);
    border-left: 3px solid var(--accent);
    color: var(--ink);
    font-size: var(--t3);
    font-weight: 600;
    text-decoration: none;
  }

  .home-base {
    color: var(--ink-2);
    font-size: var(--lbl);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .city-directory {
    grid-template-columns: 1fr 1fr;
    column-gap: var(--s5);
    padding-bottom: var(--s5);
  }

  .directory-footer {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    color: var(--link);
    font-size: var(--t3);
    font-weight: 600;
    text-decoration: none;
  }

  .directory-footer:hover {
    color: var(--link-hover);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  /* ─── Actions ─── */

  .actions {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-inline-start: auto;
  }

  .phone {
    display: none;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    text-align: right;
    white-space: nowrap;
  }

  .phone-label {
    font-size: var(--lbl);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 600;
  }

  .phone-number {
    font-size: var(--t3);
    font-weight: 600;
    color: var(--ink);
  }

  .phone:hover .phone-number {
    color: var(--link);
  }

  .quote-btn {
    display: none;
  }

  /* ─── Mobile disclosure ─── */

  /*
   * Explicit reset. The templates still on legacy.css carry a global `details`
   * rule from the old design system (white fill, 1px border, 8px radius, 1.1rem
   * padding) which was written for FAQ accordions. It leaked into this menu on
   * every legacy page and rendered the button 81px tall with a white box around
   * it. The shell has to be self-defending rather than assume no other CSS is
   * present, so these are stated instead of inherited.
   */
  .menu {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
  }

  .menu > summary {
    display: flex;
    align-items: center;
    gap: var(--s2);
    height: 44px;
    padding-inline: var(--s3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r);
    cursor: pointer;
    list-style: none;
    font-size: var(--t3);
    font-weight: 600;
  }

  .menu > summary::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--ink);
    content: '';
  }

  .bars {
    position: relative;
  }

  .bars::before {
    position: absolute;
    top: -5px;
  }

  .bars::after {
    position: absolute;
    top: 5px;
  }

  .menu[open] .bars {
    background: transparent;
  }

  .menu[open] .bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu[open] .bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .panel {
    position: fixed;
    inset-inline: 0;
    top: 64px;
    /* Clears the 64px action bar plus its top border. */
    bottom: calc(65px + env(safe-area-inset-bottom, 0px));
    display: flex;
    overflow: hidden;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--rule);
    box-shadow: var(--shadow-float);
  }

  .panel-scroll {
    width: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s4) var(--gutter) var(--s6);
  }

  .mobile-primary-links,
  .mobile-directory-list {
    list-style: none;
    padding: 0;
  }

  .mobile-primary-links > li + li {
    border-top: 1px solid var(--rule);
  }

  .mobile-primary-links > li > a,
  .mobile-group-row > a {
    min-height: 56px;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--d3);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-primary-links a[aria-current='page'],
  .mobile-primary-links a.section-active {
    color: var(--link);
  }

  .mobile-group-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px;
    align-items: center;
  }

  .mobile-group-row button {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--r);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-subpanel {
    padding: var(--s3) 0 var(--s5) var(--s4);
    border-left: 1px solid var(--rule-strong);
  }

  .mobile-directory-group + .mobile-directory-group {
    margin-top: var(--s5);
  }

  .mobile-directory-list li + li {
    border-top: 1px solid var(--rule);
  }

  .mobile-directory-list a {
    min-height: 48px;
    display: flex;
    align-items: center;
