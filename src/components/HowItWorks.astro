---
/**
 * HowItWorks.astro — the process, as a numbered ledger.
 *
 * Extends the four-step process in service-content.ts to the full eight steps
 * the brief asked for, covering what happens after the crew leaves. The last
 * three steps are the ones competitors omit, and they are the ones that answer
 * "what happens to my stuff".
 *
 * FIXES A REAL DISCONNECT. The old copy said "Call or send the form" on the
 * homepage and all 14 service pages while no form existed anywhere on the site.
 * Step one now points at a quote path that is actually built.
 *
 * Rendered as a ruled ledger rather than four cards in a row, which is the
 * layout family this content kept getting shoved into.
 *
 * THREE VARIANTS.
 *
 *   `booking`  the original four steps, read straight from `serviceProcess` in
 *              service-content.ts. This is the homepage version. Four steps can
 *              be understood in a couple of seconds, which is what a booking
 *              process on a homepage is for; the longer sets turned it into
 *              documentation. The copy is the original wording, unchanged.
 *   `compact`  six steps, ending with where the material goes.
 *   `full`     eight steps with the detail behind each. For service pages.
 */
import { serviceProcess } from '../data/service-content';

interface Props {
  variant?: 'booking' | 'compact' | 'full';
}

const { variant = 'full' } = Astro.props;

/**
 * The original four steps, preserved verbatim. Step one's "Call or send the
 * form" was aspirational when it was written, because no form existed. It is
 * accurate now that /quote is built, so the wording stands.
 */
const bookingSteps = serviceProcess.map((step) => ({ title: step.title, text: step.text }));

/**
 * The compact set folds the disposal story into its final step, which is why
 * the homepage no longer needs a standalone "where it goes" section.
 */
const compactSteps = [
  {
    title: 'Send photos or call',
    text: 'A few shots of the pile and the path to it is enough.',
  },
  {
    title: 'Get an estimate',
    text: 'We confirm you are in the service area and come back with a range and the soonest windows.',
  },
  {
    title: 'Schedule the pickup',
    text: 'Pick a window that works for the property and our route. Same-day is often possible if you call early.',
  },
  {
    title: 'The price is confirmed on site',
    text: 'The crew sees the job and confirms the number. Nothing is loaded until you agree to it.',
  },
  {
    title: 'We load it',
    text: 'From wherever it sits, inside or out. You do not move anything to the curb first.',
  },
  {
    title: 'We clean up and haul it away',
    text: 'The area is swept, then usable items go for reuse, metal and electronics for recovery, and only the rest to disposal.',
  },
];

const fullSteps = [
  {
    title: 'Send photos or call',
    text: 'A few photos of the pile and the path to it is enough to start. Calling works too if it is easier to explain than to photograph.',
  },
  {
    title: 'Tell us the details that matter',
    text: 'Your ZIP, roughly what is going, and anything about access: stairs, gates, a long carry from the door. These are what keep an estimate accurate.',
  },
  {
    title: 'We confirm the area and come back with a number',
    text: 'We check the property is in the service area, then send an estimate and the soonest windows we have.',
  },
  {
    title: 'Pick a window',
    text: 'Same-day is often possible when you get in touch early and the job fits an existing route. Otherwise we book the next one that works for you.',
  },
  {
    title: 'The crew arrives and confirms the price',
    text: 'They see the job, confirm the number, and nothing is loaded until you agree to it. If there is more than expected, you decide before it goes on the trailer.',
  },
  {
    title: 'We load it',
    text: 'From wherever it sits: inside the house, the garage, the patio, the yard. You do not move anything to the curb first unless you want to.',
  },
  {
    title: 'We sweep up',
    text: 'The area is left clean. That is part of the job, not an extra.',
  },
  {
    title: 'The load gets sorted',
    text: 'Usable items are separated for reuse, metal and electronics go to recovery, green waste goes to a green waste facility, and only what is left goes to disposal.',
  },
];

const steps =
  variant === 'booking' ? bookingSteps : variant === 'compact' ? compactSteps : fullSteps;
---

<ol class="steps" data-reveal>
  {
    steps.map((step) => (
      <li>
        <span class="num data" aria-hidden="true" />
        <span class="lead" aria-hidden="true" />
        <div class="body">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* ──────────────────────── A ledger, not cards ────────────────────────
     The content here is the original four steps, kept verbatim because their
     simplicity was the point. What changed is the reading: a numeral, a ticked
     lead line, then the step. The lead lines make the four numbers scan as one
     sequence going somewhere rather than as four separate items. */

  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
    border-top: 2px solid var(--ink);
  }

  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    grid-template-areas:
      'num body'
      'num body';
    column-gap: var(--s4);
    align-items: start;
    padding-block: var(--s5);
    border-bottom: 1px solid var(--rule);
  }

  .num {
    grid-area: num;
  }

  .num::before {
    content: counter(step, decimal-leading-zero);
    font-size: var(--num-md);
    font-weight: 700;
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* The lead line is a supporting detail, so it is the thing that disappears on
     a phone rather than something that has to be squeezed in. */
  .lead {
    display: none;
  }

  .body {
    grid-area: body;
  }

  h3 {
    font-size: var(--t1);
    letter-spacing: -0.005em;
  }

  p {
    margin-top: var(--s2);
    color: var(--ink-2);
    max-width: 64ch;
  }

  @media (min-width: 768px) {
    li {
      grid-template-columns: 4rem 5rem minmax(0, 1fr);
      grid-template-areas: 'num lead body';
      column-gap: var(--s5);
      padding-block: var(--s6);
      align-items: start;
    }

    .num::before {
      font-size: var(--num-lg);
      color: var(--ink);
    }

    .lead {
      grid-area: lead;
      display: block;
      /* Sits on the optical centre line of the step title. */
      margin-top: 0.85em;
      height: 7px;
      border-bottom: 1px solid var(--rule-strong);
      background-image: repeating-linear-gradient(
        to right,
        var(--rule-strong) 0 1px,
        transparent 1px 14px
      );
      background-repeat: repeat-x;
      background-position: left bottom;
      background-size: 100% 4px;
    }

    h3 {
      font-size: var(--d3);
    }
  }
</style>