---
/**
 * ServiceAreaMap.astro — the coverage area, drawn from the real coordinates.
 *
 * ─────────────────────────── Why it is drawn ───────────────────────────
 *
 * NOT generated imagery. A picture of a map has to be geographically true or it
 * is a false claim about where the business works, and an image model cannot be
 * held to that. Every position here is projected from the `geo` field already in
 * locations.ts, so the map cannot disagree with the data: move a city's
 * coordinates and the dot moves with it.
 *
 * The projection is equirectangular with the longitude scaled by cos(latitude).
 * Across roughly half a degree at 33°N the error against a proper conic
 * projection is far smaller than the dots, and it keeps the relative geometry —
 * Scottsdale north-west, Gold Canyon east, San Tan Valley south — honest.
 *
 * ─────────────────────────── Not load-bearing ───────────────────────────
 *
 * The map carries no crawlable information. Every city is a plain anchor in the
 * directory beside it, which is what search engines and assistants read; this is
 * the picture of that list for people. It is marked up as an image with a title
 * and description so a screen reader gets one useful sentence instead of
 * thirty-odd stray text nodes.
 */
import { locations } from '../data/locations';
import { serviceAreaLocations, isHomeCity } from '../lib/links';

interface Props {
  /**
   * Slug of the city this map is being shown ON, if any. That city is marked as
   * the current one so a visitor on a city page can find it immediately. The
   * home base keeps its own marker either way — they are different facts and
   * the map should not conflate them.
   */
  highlight?: string;
}

const { highlight } = Astro.props;

/* Every place we go, including the home market. Mesa has no /locations page —
   the homepage is its page — but it must still appear on the map, because a
   coverage map missing the city the business is based in is simply wrong. */
const home = locations.find((l) => isHomeCity(l.slug));
const cities = [...(home ? [home] : []), ...serviceAreaLocations];

/* Projection ------------------------------------------------------------- */

const VB = { w: 640, h: 440, pad: 92 };

const lats = cities.map((c) => c.geo.latitude);
const lons = cities.map((c) => c.geo.longitude);
const latMid = (Math.max(...lats) + Math.min(...lats)) / 2;
const kx = Math.cos((latMid * Math.PI) / 180);

const xs = lons.map((l) => l * kx);
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
const minY = Math.min(...lats);
const maxY = Math.max(...lats);

const spanX = maxX - minX || 1;
const spanY = maxY - minY || 1;

/** Fit the bounding box into the padded viewBox without distorting the aspect. */
const scale = Math.min((VB.w - VB.pad * 2) / spanX, (VB.h - VB.pad * 2) / spanY);
const offX = (VB.w - spanX * scale) / 2;
const offY = (VB.h - spanY * scale) / 2;

/**
 * Label placement. The default (to the right of the dot, or to the left near the
 * right edge) is right for most of the map, but the East Valley puts Mesa and
 * Apache Junction at almost the same latitude a short distance apart, so their
 * labels overlapped, and the two southern cities sat on the boundary line. These
 * are the exceptions, keyed by slug; anything not listed uses the default, so
 * adding a city degrades to a sensible position rather than to a broken one.
 */
const LABEL: Record<string, { anchor: 'start' | 'middle' | 'end'; dx: number; dy: number }> = {
  'mesa-az': { anchor: 'middle', dx: 0, dy: -20 },
  /* Long name close to the right edge: it runs past the frame set outward. */
  'apache-junction-az': { anchor: 'end', dx: -14, dy: 6 },
  'queen-creek-az': { anchor: 'end', dx: -14, dy: 6 },
  'san-tan-valley-az': { anchor: 'middle', dx: 0, dy: 28 },
  'ahwatukee-az': { anchor: 'end', dx: -14, dy: 6 },
  'tempe-az': { anchor: 'end', dx: -14, dy: 6 },
};

const points = cities.map((c) => {
  const x = offX + (c.geo.longitude * kx - minX) * scale;
  /* SVG y grows downward, latitude grows north, so invert. */
  const y = offY + (maxY - c.geo.latitude) * scale;
  /* Default: to the right, flipping inside near the right edge. */
  const fallback =
    x > VB.w * 0.7
      ? { anchor: 'end' as const, dx: -14, dy: 6 }
      : { anchor: 'start' as const, dx: 14, dy: 6 };
  const label = LABEL[c.slug] ?? fallback;

  return {
    slug: c.slug,
    city: c.city,
    isHome: isHomeCity(c.slug),
    isCurrent: highlight === c.slug,
    x,
    y,
    label,
  };
});

/** Convex hull (gift wrapping) — the outline of everywhere we actually go. */
const hull = (() => {
  const pts = points.map((p) => ({ x: p.x, y: p.y }));
  if (pts.length < 3) return '';
  let start = pts.reduce((a, b) => (b.x < a.x ? b : a));
  const out = [];
  let current = start;
  do {
    out.push(current);
    let next = pts[0];
    for (const p of pts) {
      if (p === current) continue;
      const cross =
        (next.x - current.x) * (p.y - current.y) - (next.y - current.y) * (p.x - current.x);
      if (next === current || cross < 0) next = p;
    }
    current = next;
  } while (current !== start && out.length <= pts.length);
  return out.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
})();

const names = points.map((p) => p.city).join(', ');
---

<figure class="map">
  <svg
    viewBox={`0 0 ${VB.w} ${VB.h}`}
    role="img"
    aria-labelledby="map-title map-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="map-title">Load Logic service area</title>
    <desc id="map-desc">
      A map of the East Valley showing the cities Load Logic serves: {names}. Mesa
      is the home base.
    </desc>

    {/* The covered area. Filled faintly so it reads as territory rather than as
        a route line joining ten dots. */}
    {hull && <polygon class="area" points={hull} />}

    {
      points.map((p) => (
        <g
          class:list={[
            'pin',
            { home: p.isHome, current: p.isCurrent, 'home-muted': p.isHome && Boolean(highlight) },
          ]}
        >
          {/* The current city is drawn twice: an accent halo under a solid dot, so
              it outranks the home marker at a glance rather than merely differing
              from it. */}
          {p.isCurrent && <circle class="halo" cx={p.x} cy={p.y} r={14} />}
          <circle cx={p.x} cy={p.y} r={p.isCurrent ? 8 : p.isHome ? 8 : 5.5} />
          <text
            x={p.x + p.label.dx}
            y={p.y + p.label.dy}
            text-anchor={p.label.anchor}
          >
            {p.city}
          </text>
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .map {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
  }

  .area {
    fill: var(--steel);
    fill-opacity: 0.08;
    stroke: var(--steel);
    stroke-opacity: 0.55;
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .pin circle {
    fill: var(--steel);
  }

  .pin text {
    font-family: var(--font-data);
    font-size: 19px;
    fill: var(--ink-2);
    letter-spacing: 0.005em;
  }

  /* The city whose page this is: the one safety-orange mark on the map, so it
     is found at a glance. */
  .current circle {
    fill: var(--accent);
  }

  .current .halo {
    fill: var(--accent);
    fill-opacity: 0.22;
    stroke: none;
  }

  .current text {
    fill: var(--ink);
    font-weight: 700;
  }

  /* The home base reads first without borrowing the accent: solid charcoal,
     heavier than the steel field pins. */
  .home circle {
    fill: var(--charcoal);
    stroke: none;
  }

  .home text {
    fill: var(--ink);
    font-weight: 700;
  }

  /* On a city page the home base is still shown, but it stops competing with the
     city the visitor is actually on. */
  .home-muted circle {
    fill: var(--steel);
    stroke: none;
  }

  .home-muted text {
    fill: var(--ink-2);
    font-weight: 400;
  }
</style>
