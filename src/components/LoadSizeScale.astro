---
/**
 * LoadSizeScale.astro — "How much junk do you have?"
 *
 * The site's signature component and the fastest route to a real price. Volume
 * is the primary pricing input, so helping someone estimate their own volume
 * answers the cost question before a form is involved.
 *
 * WHY DIAGRAMS, NOT PHOTOGRAPHS. Three photographic attempts failed: with the
 * truck in frame the trailer was unreadable and swapped between frames, and
 * trailer-only runs either returned an empty deck or, at higher strength, turned
 * into a different vehicle. An instrument that changes between readings measures
 * nothing. The SVGs are drawn from the fractions in pricing.ts so the drawing
 * and the data cannot disagree, and each load's drawn AREA is proportional to
 * its fraction. See docs/image-art-direction.md section 5.2.
 *
 * WRITTEN FOR SOMEONE WHO HAS NEVER THOUGHT IN CUBIC YARDS. The recognisable
 * example leads, the fraction supports it, and the cubic yard figure comes last
 * as a secondary detail for anyone who wants it.
 *
 * HONESTY. Every figure is an estimate and says so. Amounts stay hidden behind
 * `published: false` until real pricing is supplied, so this shows how much junk
 * you have, never what it will cost.
 */
import {
  loadScale,
  isPricingPublished,
  formatVolume,
  formatPrice,
  formatPriceCompact,
  pricingTerms,
} from '../data/pricing';
import { confirmedCapacityCubicYards, fleetLimits } from '../data/equipment';

const loads = loadScale();
const capacity = confirmedCapacityCubicYards();
const showPrices = isPricingPublished();

/**
 * Diagrams are imported explicitly rather than through import.meta.glob. The
 * glob form needs a type generic, and a generic on a call expression is
 * ambiguous with JSX once the Astro compiler hands the file to esbuild as TSX,
 * which fails the build. Six explicit imports are also easier to follow.
 */
import dSingle from '../assets/diagrams/load-single-item.svg?url';
import dSmall from '../assets/diagrams/load-small.svg?url';
import dQuarter from '../assets/diagrams/load-quarter.svg?url';
import dHalf from '../assets/diagrams/load-half.svg?url';
import dThreeQuarter from '../assets/diagrams/load-three-quarter.svg?url';
import dFull from '../assets/diagrams/load-full.svg?url';

const diagrams: Record<string, string> = {
  'load-single-item': dSingle,
  'load-small': dSmall,
  'load-quarter': dQuarter,
  'load-half': dHalf,
  'load-three-quarter': dThreeQuarter,
  'load-full': dFull,
};

const diagramFor = (image: string): string | undefined => diagrams[image];

/** Assembled here so the optional capacity does not pick up template whitespace. */
const fullLoadNote = `A full load means our ${
  capacity ? `${capacity} cubic yard ` : ''
}open utility trailer filled to the rails. Sizes are judged on site before anything is loaded, and you approve the price first.`;
---

<div class="scale" data-reveal>
  <ol class="steps">
    {
      loads.map((load) => {
        const src = diagramFor(load.image);
        return (
          <li class="step">
            {src && (
              <img
                class="diagram"
                src={src}
                alt={`Diagram: ${load.name}, about ${Math.round(load.fraction * 100)} percent of a full trailer`}
                width="300"
                height="180"
                loading="lazy"
                decoding="async"
              />
            )}

            {/* The scale reading, set as the largest thing in the row. Six of
                these stacked form a column that climbs 8, 15, 25, 50, 75, 100,
                which is what turns a list of options into a gauge you read. */}
            <p class="frac data" aria-hidden="true">
              {Math.round(load.fraction * 100)}<span class="pct">%</span>
            </p>

            <div class="text">
              <h3>{load.name}</h3>
              <p class="summary">{load.summary}</p>
            </div>

            <ul class="examples">
              {load.exampleContents.map((ex) => (
                <li>{ex}</li>
              ))}
            </ul>

            <div class="readings">
              {showPrices && formatPriceCompact(load.price) && (
                <p class="price data">{formatPriceCompact(load.price)}</p>
              )}
              <p class="volume data">{formatVolume(load)}</p>
            </div>
          </li>
        );
      })
    }
  </ol>

  <footer class="notes">
    {
      showPrices && (
        <p class="minimum">
          <strong>Minimum {formatPrice(pricingTerms.minimum)}.</strong>{' '}
          {pricingTerms.minimum.description}
        </p>
      )
    }
    <p>
      <strong>These are estimates.</strong> {fullLoadNote}
    </p>
    <p>
      {fleetLimits.consequence}
    </p>
    {
      !showPrices && (
        <p class="pending">
          Prices are quoted per job rather than published as a fixed list. Send
          photos and you get a real number back, not a range.
        </p>
      )
    }
  </footer>
</div>

<style>
  /* ─────────────────────── The instrument ───────────────────────
     Read as a gauge, not as a list of six options. The percentage climbs down
     the left edge in a fixed-width mono column, the drawn trailer fills beside
     it, and the price and volume sit in a right-hand readings column so all six
     numbers align vertically and can be compared without moving your eye. */

  .steps {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .step {
    display: grid;
    /* Mobile is its own composition, not the desktop row stacked: reading on the
       top-left, price on the top-right, drawing and description beneath. */
    /* Fluid so the drawing grows with the screen instead of staying at phone
       size on a tablet, where the text column has width to spare. */
    grid-template-columns: clamp(5.5rem, 13vw, 9rem) minmax(0, 1fr);
    grid-template-areas:
      'frac read'
      'diag text'
      'ex   ex';
    column-gap: var(--s4);
    row-gap: var(--s3);
    align-items: start;
    padding-block: var(--s5);
    border-bottom: 1px solid var(--rule);
  }

  .frac {
    grid-area: frac;
    font-size: var(--num-lg);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* The unit rides small and high off the numeral so the number itself keeps
     the weight. */
  .pct {
    font-size: 0.34em;
    font-weight: 600;
    color: var(--ink-3);
    vertical-align: super;
    margin-inline-start: 0.12em;
    letter-spacing: 0;
  }

  .diagram {
    grid-area: diag;
    width: 100%;
    max-width: 300px;
    height: auto;
  }

  .text {
    grid-area: text;
  }

  h3 {
    font-size: var(--d3);
  }

  .summary {
    margin-top: var(--s2);
    color: var(--ink-2);
    max-width: 46ch;
    font-size: var(--t3);
  }

  /* The recognisable examples carry most of the meaning here, because "a packed
     two-car garage" is far easier to judge yourself against than a number.
     Square-edged and rule-bound rather than pills: this section is an
     instrument, and the chips were the one soft shape in it. */
  .examples {
    grid-area: ex;
    padding: 0;
    margin-top: var(--s3);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .examples li {
    font-size: var(--t3);
    padding: var(--s1) var(--s3);
    border: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }

  .readings {
    grid-area: read;
    text-align: end;
  }

  /* The price is the answer people came for, so it gets display weight. */
  .price {
    font-size: var(--t1);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .volume {
    margin-top: var(--s1);
    font-size: var(--t3);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .notes {
    margin-top: var(--s6);
    display: grid;
    gap: var(--s3);
    max-width: 62ch;
    font-size: var(--t3);
    color: var(--ink-2);
  }

  .pending {
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  .minimum {
    padding-inline-start: var(--s4);
    border-inline-start: 3px solid var(--hi-vis);
  }

  .minimum strong {
    color: var(--ink);
  }

  @media (min-width: 860px) {
    /* One horizontal row per load: reading, drawing, description, price. */
    .step {
      /* Fluid, not fixed. The numeral column has to track the numeral, which is
         itself a clamp on viewport width: at a fixed 14rem the text column
         collapsed to 200px around 1024 and the descriptions wrapped to ribbons.
         Roughly 2x the numeral's font-size is what three digits plus the unit
         need. */
      grid-template-columns:
        clamp(7rem, 16vw, 14rem)
        clamp(9rem, 18vw, 230px)
        minmax(0, 1fr)
        minmax(0, 9rem);
      grid-template-areas:
        'frac diag text read'
        'frac diag ex   read';
      column-gap: clamp(var(--s5), 3vw, var(--s7));
      padding-block: var(--s6);
      align-items: center;
    }

    .frac {
      font-size: var(--num-xl);
      /* Optical alignment: the mono numerals sit slightly right of the rule
         they share with the section masthead without this. */
      margin-inline-start: -0.04em;
    }

    .summary {
      font-size: var(--t2);
    }

    .price {
      font-size: var(--d3);
    }
  }
</style>
