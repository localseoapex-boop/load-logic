---
/**
 * LoadSizeScale.astro — "How much junk do you have?"
 *
 * The site's signature component and the fastest route to a real price. Volume
 * is the primary pricing input, so helping someone estimate their own volume
 * answers the cost question before a form is involved.
 *
 * WHY DIAGRAMS, NOT PHOTOGRAPHS. Three photographic attempts failed: with the
 * truck in frame the trailer was unreadable and swapped between frames, and
 * trailer-only runs either returned an empty deck or, at higher strength, turned
 * into a different vehicle. An instrument that changes between readings measures
 * nothing. The SVGs are drawn from the fractions in pricing.ts so the drawing
 * and the data cannot disagree, and each load's drawn AREA is proportional to
 * its fraction. See docs/image-art-direction.md section 5.2.
 *
 * WRITTEN FOR SOMEONE WHO HAS NEVER THOUGHT IN CUBIC YARDS. The recognisable
 * example leads, the fraction supports it, and the cubic yard figure comes last
 * as a secondary detail for anyone who wants it.
 *
 * HONESTY. Prices are STARTING figures, from pricing.ts. Every rendering says
 * "Starting at" rather than showing a bare amount, because a floor shown as a
 * bare number reads as a fixed price. Amounts stay behind `published: false`
 * until real pricing is supplied.
 *
 * TWO LAYOUTS. `rows` is the full-width instrument used on /pricing, where the
 * page exists to explain price and the reading can take the space. `grid` is the
 * homepage form: the same six loads as compact cells, two across, so the scale
 * occupies one column of a two-column tool instead of six full-width rows the
 * visitor has to scroll past.
 */
import {
  loadScale,
  isPricingPublished,
  formatVolume,
  formatAmount,
} from '../data/pricing';
import { confirmedCapacityCubicYards, fleetLimits } from '../data/equipment';

interface Props {
  layout?: 'rows' | 'grid';
}

const { layout = 'rows' } = Astro.props;

const loads = loadScale();
const capacity = confirmedCapacityCubicYards();
const showPrices = isPricingPublished();

/**
 * Diagrams are imported explicitly rather than through import.meta.glob. The
 * glob form needs a type generic, and a generic on a call expression is
 * ambiguous with JSX once the Astro compiler hands the file to esbuild as TSX,
 * which fails the build. Six explicit imports are also easier to follow.
 */
import dSingle from '../assets/diagrams/load-single-item.svg?url';
import dSmall from '../assets/diagrams/load-small.svg?url';
import dQuarter from '../assets/diagrams/load-quarter.svg?url';
import dHalf from '../assets/diagrams/load-half.svg?url';
import dThreeQuarter from '../assets/diagrams/load-three-quarter.svg?url';
import dFull from '../assets/diagrams/load-full.svg?url';

const diagrams: Record<string, string> = {
  'load-single-item': dSingle,
  'load-small': dSmall,
  'load-quarter': dQuarter,
  'load-half': dHalf,
  'load-three-quarter': dThreeQuarter,
  'load-full': dFull,
};

const diagramFor = (image: string): string | undefined => diagrams[image];

/** Assembled here so the optional capacity does not pick up template whitespace. */
const fullLoadNote = `A full load means our ${
  capacity ? `${capacity} cubic yard ` : ''
}open utility trailer filled to the rails. The final price depends on volume, material, access and labour, and it is confirmed on site before anything is loaded.`;
---

<div class:list={['scale', layout]} data-reveal>
  <ol class="steps">
    {
      loads.map((load) => {
        const src = diagramFor(load.image);
        return (
          <li class="step">
            {src && (
              <img
                class="diagram"
                src={src}
                alt={`Diagram: ${load.name}, about ${Math.round(load.fraction * 100)} percent of a full trailer`}
                width="300"
                height="180"
                loading="lazy"
                decoding="async"
              />
            )}

            {/* The scale reading, set as the largest thing in the row. Six of
                these stacked form a column that climbs 8, 15, 25, 50, 75, 100,
                which is what turns a list of options into a gauge you read. */}
            <p class="frac data" aria-hidden="true">
              {Math.round(load.fraction * 100)}<span class="pct">%</span>
            </p>

            <div class="text">
              <h3>{load.name}</h3>
              <p class="summary">{load.summary}</p>
            </div>

            <ul class="examples">
              {load.exampleContents.map((ex) => (
                <li>{ex}</li>
              ))}
            </ul>

            {/* "Starting at" is part of the reading, never implied. A floor
                rendered as a bare number reads as a fixed price. */}
            <div class="readings">
              {showPrices && formatAmount(load.price) && (
                <p class="price">
                  <span class="from">Starting at</span>
                  <span class="amount data">{formatAmount(load.price)}</span>
                </p>
              )}
              <p class="volume data">{formatVolume(load)}</p>
            </div>
          </li>
        );
      })
    }
  </ol>

  {layout === 'rows' && (
  <footer class="notes">
    {/* The separate minimum is gone: under starting prices the single-item
        figure IS the floor, so publishing a second, lower number alongside it
        stated two different smallest prices for the same job. */}
    <p>
      <strong>These are starting prices.</strong> {fullLoadNote}
    </p>
    <p>
      {fleetLimits.consequence}
    </p>
    {
      !showPrices && (
        <p class="pending">
          Prices are quoted per job rather than published as a fixed list. Send
          photos and you get a real number back, not a range.
        </p>
      )
    }
  </footer>
  )}
</div>

<style>
  /* ─────────────────────── The instrument ───────────────────────
     Two layouts over one set of readings. `rows` is the full-width version on
     /pricing. `grid` is the homepage version: the same six loads as compact
     cells so the scale becomes one column of a two-column tool rather than six
     full-width rows to scroll past. */

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .frac {
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pct {
    font-size: 0.34em;
    font-weight: 600;
    color: var(--ink-3);
    vertical-align: super;
    margin-inline-start: 0.12em;
    letter-spacing: 0;
  }

  .diagram {
    width: 100%;
    height: auto;
  }

  h3 {
    font-size: var(--d3);
  }

  .summary {
    margin-top: var(--s2);
    color: var(--ink-2);
    max-width: 46ch;
    font-size: var(--t3);
  }

  /* Square-edged and rule-bound rather than pills: this is an instrument, and
     the chips were the one soft shape in it. */
  .examples {
    padding: 0;
    margin-top: var(--s3);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .examples li {
    font-size: var(--t3);
    padding: var(--s1) var(--s3);
    border: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .from {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .amount {
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-size: var(--d3);
    line-height: 1;
  }

  .volume {
    margin-top: var(--s2);
    font-size: var(--t3);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .notes {
    margin-top: var(--s6);
    display: grid;
    gap: var(--s3);
    max-width: 62ch;
    font-size: var(--t3);
    color: var(--ink-2);
  }

  .notes strong {
    color: var(--ink);
  }

  .pending {
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  /* ─────────────────────────── grid layout ─────────────────────────── */

  .grid .steps {
    display: grid;
    gap: var(--s5);
    border-top: 2px solid var(--ink);
  }

  .grid .step {
    display: grid;
    grid-template-columns: minmax(0, 5rem) minmax(0, 1fr);
    grid-template-areas:
      'diag  head'
      'diag  price';
    column-gap: var(--s4);
    align-items: center;
    padding-block: var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  .grid .diagram {
    grid-area: diag;
  }

  .grid .frac,
  .grid .summary,
  .grid .examples {
    display: none;
  }

  .grid .text {
    grid-area: head;
  }

  .grid h3 {
    font-size: var(--t1);
  }

  .grid .readings {
    grid-area: price;
  }

  .grid .volume {
    display: none;
  }

  .grid .amount {
    font-size: var(--t1);
  }

  @media (min-width: 560px) {
    .grid .steps {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s6);
    }
  }

  /* ─────────────────────────── rows layout ─────────────────────────── */

  .rows .steps {
    border-top: 2px solid var(--ink);
  }

  .rows .step {
    display: grid;
    grid-template-columns: clamp(5.5rem, 13vw, 9rem) minmax(0, 1fr);
    grid-template-areas:
      'frac read'
      'diag text'
      'ex   ex';
    column-gap: var(--s4);
    row-gap: var(--s3);
    align-items: start;
    padding-block: var(--s5);
    border-bottom: 1px solid var(--rule);
  }

  .rows .frac {
    grid-area: frac;
    font-size: var(--num-lg);
  }

  .rows .diagram {
    grid-area: diag;
    max-width: 300px;
  }

  .rows .text {
    grid-area: text;
  }

  .rows .examples {
    grid-area: ex;
  }

  .rows .readings {
    grid-area: read;
    text-align: end;
  }

  .rows .price {
    align-items: flex-end;
  }

  @media (min-width: 860px) {
    .rows .step {
      grid-template-columns:
        clamp(7rem, 16vw, 14rem)
        clamp(9rem, 18vw, 230px)
        minmax(0, 1fr)
        minmax(0, 11rem);
      grid-template-areas:
        'frac diag text read'
        'frac diag ex   read';
      column-gap: clamp(var(--s5), 3vw, var(--s7));
      padding-block: var(--s6);
      align-items: center;
    }

    .rows .frac {
      font-size: var(--num-xl);
      margin-inline-start: -0.04em;
    }

    .rows .summary {
      font-size: var(--t2);
    }
  }
</style>