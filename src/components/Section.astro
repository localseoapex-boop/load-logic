---
/**
 * Section.astro — the page's structural unit.
 *
 * ────────────────────────── Why this was rebuilt ──────────────────────────
 *
 * The previous version had two levers, `weight` (padding) and `tone`
 * (background), and neither carried enough signal to be felt. Measured on the
 * rendered page, every section heading came out at exactly 52px/700, padding
 * took one of two values, and the light/sunk alternation was a ten-point
 * difference in RGB. So the page had eight sections that announced themselves
 * at identical volume against a background that never actually changed. That is
 * the whole of why it read as "content, section, content, section" — not the
 * content, which is good, but the total absence of hierarchy between sections.
 *
 * Three levers now, and they are meant to be obvious:
 *
 *   SCALE    display / standard / utility. The load scale and the FAQ are not
 *            equally important and must not be set at the same size. The steps
 *            are far apart on purpose.
 *
 *   TONE     light, sunk, white or dark. `white` is a genuine surface change
 *            rather than a tint, and dark is now allowed to appear mid-page as
 *            a major transition instead of only bookending it.
 *
 *   INDEX    an optional section numeral. Beyond wayfinding, this is the page's
 *            recurring field-documentation detail: a mono index, a ticked rule,
 *            and an operational label, sitting above the heading like the header
 *            on a job sheet. It gives every section a hard horizontal anchor at
 *            its top edge, which is what makes the sections distinguishable when
 *            you scroll past them quickly without reading.
 *
 * MEDIA SLOT. A section header at desktop leaves most of the row empty, because
 * the heading and intro are measured to a readable width. Filling the `media`
 * slot puts a photograph in that space instead of adding a separate image
 * section. On mobile the image stacks under the header at full width.
 */
interface Props {
  weight?: 'tight' | 'standard' | 'feature';
  tone?: 'light' | 'sunk' | 'white' | 'dark';
  width?: 'content' | 'wide' | 'narrow';
  /** Heading size. Ration `display` to the two or three signature sections. */
  scale?: 'display' | 'standard' | 'utility';
  /** Section numeral, e.g. "02". Rendered mono beside a ticked rule. */
  index?: string;
  /** Uppercase operational label, sits at the far end of the index rule. */
  label?: string;
  heading?: string;
  /** Sub-heading paragraph. Stacked under the heading, never floated right. */
  intro?: string;
  /** Anchor target, e.g. for the quote starter or the ZIP checker. */
  id?: string;
  /** Opt out of the scroll reveal for above-the-fold content. */
  reveal?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  weight = 'standard',
  tone = 'light',
  width = 'content',
  scale = 'standard',
  index,
  label,
  heading,
  intro,
  id,
  reveal = true,
  headingLevel: Heading = 'h2',
  class: className = '',
} = Astro.props;

const hasMasthead = Boolean(index || label);
const hasHeader = Boolean(heading || intro || hasMasthead);
const hasMedia = Astro.slots.has('media');
---

<section
  class:list={['section', weight, tone, className, { 'on-dark': tone === 'dark' }]}
  {id}
>
  <div
    class:list={[
      'container',
      { 'container-wide': width === 'wide', 'container-narrow': width === 'narrow' },
    ]}
  >
    {
      hasMasthead && (
        <div class="masthead" data-reveal={reveal ? '' : undefined}>
          {index && <span class="idx">{index}</span>}
          <span class="tickrule" aria-hidden="true" />
          {label && <span class="lbl">{label}</span>}
        </div>
      )
    }
    {
      hasHeader && (heading || intro) && (
        <div class:list={['head-row', `row-${scale}`, { 'with-media': hasMedia }]}>
          <header class:list={['head', `scale-${scale}`]} data-reveal={reveal ? '' : undefined}>
            {heading && <Heading>{heading}</Heading>}
            {intro && <p class="intro">{intro}</p>}
          </header>
          {hasMedia && (
            <div class="head-media" data-reveal={reveal ? '' : undefined}>
              <slot name="media" />
            </div>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
  }

  /* ─── Weight ─── */

  .tight {
    padding-block: var(--sec-tight-t) var(--sec-tight-b);
  }

  .standard {
    padding-block: var(--sec-std-t) var(--sec-std-b);
  }

  .feature {
    padding-block: var(--sec-feature-t) var(--sec-feature-b);
  }

  /* ─── Tone ─── */

  .light {
    background: var(--background);
  }

  .sunk {
    background: var(--surface-alt);
  }

  /* Explicit white. Same value as the page ground now that the page is white;
     kept as a tone so section markup stays declarative. */
  .white {
    background: var(--surface);
  }

  /* Rather than override every child component's colours one by one, the dark
     section REMAPS the tokens its children already read. A component written for
     the light page (rules, muted text, a white panel) then renders correctly on
     dark without knowing it is on dark, and anything added later inherits the
     same behaviour for free. This is why the proof section can host the job
     record, the equipment table and the before/after slider unmodified. */
  .dark {
    --ink: #ffffff;
    --ink-2: var(--on-dark);
    --ink-3: var(--on-dark-2);
    --rule: var(--rule-on-dark);
    --rule-strong: #5c6268;
    /* Anything expecting a raised panel gets a lifted charcoal, not white. */
    --surface: var(--dark-2);
    --surface-alt: var(--dark);
    --surface-alt-2: var(--dark-2);
    /* Charcoal link text is invisible against charcoal: on dark, links run
       white and the accent takes over on hover/focus. */
    --link: var(--white);
    --link-hover: var(--accent);

    background: var(--dark);
    color: var(--on-dark);
  }

  .dark :global(h2),
  .dark :global(h3) {
    color: #fff;
  }

  /* ─── Masthead: index, ticked rule, operational label ─── */

  .masthead {
    display: flex;
    align-items: center;
    gap: var(--s4);
    margin-bottom: var(--s7);
  }

  .idx {
    font-family: var(--font-data);
    font-size: var(--t2);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    flex: none;
  }

  /* The recurring measurement detail. A baseline with ticks rising off it, at a
     pitch loose enough to read as a ruler edge rather than as a pattern. */
  .tickrule {
    flex: 1;
    height: 7px;
    border-bottom: 1px solid var(--rule-strong);
    background-image: repeating-linear-gradient(
      to right,
      var(--rule-strong) 0 1px,
      transparent 1px 14px
    );
    background-repeat: repeat-x;
    background-position: left bottom;
    background-size: 100% 4px;
  }

  .lbl {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    flex: none;
  }

  .dark .idx {
    color: var(--accent);
  }

  .dark .tickrule {
    border-bottom-color: var(--rule-on-dark);
    background-image: repeating-linear-gradient(
      to right,
      var(--rule-on-dark) 0 1px,
      transparent 1px 14px
    );
  }

  .dark .lbl {
    color: var(--on-dark-2);
  }

  /* ─── Header block ─── */

  .head-row {
    margin-bottom: var(--s6);
  }

  .head {
    /* Wide enough that a display heading does not wrap into a narrow column and
       leave most of the row empty. The intro keeps its own tighter measure. */
    max-width: 68ch;
  }

  /* ─── Heading scale ───
     Set on the header so the size travels with the section, not with the tag.
     The classes are namespaced `scale-*` deliberately: an unprefixed `standard`
     on the header collided with the section's own `standard` WEIGHT class and
     silently inherited its 96/128px section padding, adding 224px of dead space
     under every standard-scale heading on the page. */

  .head.scale-display :global(h2) {
    font-size: var(--d1);
    letter-spacing: 0;
    line-height: 0.96;
  }

  .head.scale-display {
    max-width: 22ch;
  }

  .head.scale-utility :global(h2) {
    font-size: var(--d3);
  }

  /* Photography is square-cornered, per DESIGN.md. */
  .head-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-flat);
  }

  /* Beside a heading, the image is a companion to the text, not the subject. Left
     uncapped it sets the row height and pushes the heading off its own baseline. */
  @media (min-width: 900px) {
    .head-media :global(img) {
      max-height: 320px;
      object-fit: cover;
    }
  }

  .with-media .head-media {
    margin-top: var(--s5);
  }

  /* A display heading set to a short measure leaves the right half of the row
     empty, which is what made the big headings read as merely large rather than
     as composed. Where there is no photograph in the row, the intro moves into
     that space and the two sit on a shared baseline. */
  @media (min-width: 900px) {
    .head-row:not(.with-media) .head.scale-display {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--s8);
      align-items: end;
      max-width: none;
    }

    .head-row:not(.with-media) .head.scale-display :global(h2) {
      max-width: 13ch;
    }

    .head-row:not(.with-media) .head.scale-display .intro {
      margin-top: 0;
      max-width: 38ch;
      padding-bottom: 0.35em;
    }
  }

  @media (min-width: 900px) {
    .with-media {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: var(--s8);
      align-items: center;
    }

    .with-media .head:not(.scale-display) {
      max-width: 46ch;
    }

    /* A display heading needs a much wider column than a standard one. At the
       default split it was being squeezed to about 590px and breaking a
       six-word heading across five lines. */
    .with-media.row-display {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    }

    .with-media.row-display .head {
      max-width: none;
    }

    .with-media .head-media {
      margin-top: 0;
    }
  }

  .intro {
    margin-top: var(--s4);
    font-size: var(--t1);
    color: var(--ink-2);
    max-width: 54ch;
  }

  .scale-display .intro {
    margin-top: var(--s5);
  }

  .dark .intro {
    color: var(--on-dark-2);
  }
</style>
