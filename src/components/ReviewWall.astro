---
/**
 * ReviewWall.astro — one featured review, the rest in a supporting rail.
 *
 * ─────────────────────────── The gate ───────────────────────────
 *
 * Renders NOTHING unless reviews.ts holds at least one entry with
 * `verified: true`. Not a placeholder, not a skeleton, not an empty state — the
 * component returns null and the caller's whole section disappears with it, so
 * there is no blank band on the page while real reviews do not exist.
 *
 * The three stored testimonials are all `verified: false`. There is no evidence
 * any of them came from a real customer: no date, no link, no platform beyond
 * "direct", and all three first appeared in the commit that rebranded the
 * starter template. So the component is built and wired and shows nothing.
 *
 * NO Review OR AggregateRating JSON-LD is emitted here, deliberately, and none
 * should be added until the underlying reviews are confirmed. Marking up social
 * proof that cannot be substantiated is a fabricated claim.
 *
 * ─────────────────────── Shape, once it is on ───────────────────────
 *
 * Not three identical cards. One review is featured at display size, because a
 * single specific account read properly is worth more than three skimmed; the
 * others sit beneath it as a ruled rail. Each carries whatever provenance
 * exists: platform, rating, name and date. Provenance is what separates a review
 * from a slogan, so anything missing is simply not printed rather than faked.
 */
import { verifiedReviews } from '../data/reviews';

const all = verifiedReviews();
const [featured, ...rest] = all;

/** Star row as text, so it survives with images or CSS off. */
const stars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));

const platformLabel: Record<string, string> = {
  google: 'Google',
  yelp: 'Yelp',
  facebook: 'Facebook',
  direct: 'Direct to us',
};

const formatDate = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
    : undefined;
---

{
  featured && (
    <div class="reviews" data-reveal>
      <blockquote class="featured">
        <p class="stars data" aria-label={`${featured.rating} out of 5`}>
          {stars(featured.rating)}
        </p>
        <p class="quote">{featured.text}</p>
        <footer class="who">
          <span class="name">{featured.author}</span>
          <span class="meta data">
            {platformLabel[featured.platform] ?? featured.platform}
            {formatDate(featured.date) && ` · ${formatDate(featured.date)}`}
          </span>
        </footer>
      </blockquote>

      {rest.length > 0 && (
        <ul class="rail">
          {rest.map((r) => (
            <li>
              <p class="stars data" aria-label={`${r.rating} out of 5`}>
                {stars(r.rating)}
              </p>
              <p class="text">{r.text}</p>
              <p class="who small">
                <span class="name">{r.author}</span>
                <span class="meta data">
                  {platformLabel[r.platform] ?? r.platform}
                  {formatDate(r.date) && ` · ${formatDate(r.date)}`}
                </span>
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style>
  .reviews {
    display: grid;
    gap: var(--s7);
  }

  .featured {
    margin: 0;
    padding-top: var(--s5);
    border-top: 2px solid var(--ink);
  }

  .stars {
    color: var(--link);
    letter-spacing: 0.18em;
    font-size: var(--t2);
  }

  .quote {
    margin-top: var(--s4);
    font-family: var(--font-display);
    font-size: var(--d3);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.25;
    color: var(--ink);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .who {
    margin-top: var(--s5);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s4);
  }

  .name {
    font-weight: 700;
    color: var(--ink);
  }

  .meta {
    font-size: var(--lbl);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s5);
  }

  .rail li {
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
  }

  .text {
    margin-top: var(--s3);
    color: var(--ink-2);
    font-size: var(--t3);
    max-width: 48ch;
  }

  .who.small {
    margin-top: var(--s3);
  }

  @media (min-width: 900px) {
    .reviews {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--s9);
      align-items: start;
    }

    .quote {
      font-size: var(--d2);
      font-weight: 700;
    }
  }
</style>
