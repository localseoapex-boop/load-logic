---
/**
 * FaqBlock.astro — questions and answers, plus the FAQPage schema for them.
 *
 * SCHEMA RULE, preserved from the old site and worth restating: FAQPage JSON-LD
 * is emitted ONLY for questions actually rendered on this page. Schema that
 * describes content a visitor cannot see is exactly what Google penalises, so
 * the same array drives both the markup and the structured data.
 *
 * Presentation is a native <details>/<summary> accordion. Native, deliberately:
 * the answers are in the DOM whether the panel is open or shut, so they stay
 * crawlable and stay matched to the JSON-LD above; keyboard support, the
 * expanded/collapsed state and the ARIA semantics come from the browser rather
 * than from script; and it costs zero JavaScript. A scripted accordion would
 * have had to reimplement all of that and would have risked answers that exist
 * in the schema but not in the served HTML.
 */
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  /** Emit FAQPage JSON-LD. Set false when another block on the page already does. */
  schema?: boolean;
}

const { faqs, schema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<div class="faqs" data-reveal>
  {
    faqs.map((faq) => (
      <details class="qa" name="home-faq">
        <summary>
          <span class="q">{faq.question}</span>
          <span class="sign" aria-hidden="true" />
        </summary>
        <div class="a">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>

{
  schema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  )
}

<style>
  /* ─────────────────── Native accordion ───────────────────
     <details name="..."> makes the group exclusive: opening one closes the
     others, which is the behaviour a scripted accordion is usually written to
     provide. Browsers without support simply allow several open at once, which
     is a perfectly good fallback rather than a broken one. */

  .faqs {
    border-top: 2px solid var(--ink);
  }

  .qa {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    /* A comfortable tap target: this row is the whole control. */
    padding-block: var(--s4);
    cursor: pointer;
    list-style: none;
  }

  /* Safari draws its own triangle unless this is removed. */
  summary::-webkit-details-marker {
    display: none;
  }

  .q {
    font-family: var(--font-display);
    font-size: var(--t1);
    font-weight: 700;
    letter-spacing: 0.005em;
    color: var(--ink-heading);
    max-width: 46ch;
  }

  /* A plus that becomes a minus. Two bars, one rotated, so the state change is
     a transform rather than a glyph swap. */
  .sign {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 7px;
    width: 16px;
    height: 2px;
    background: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .sign::after {
    transform: rotate(0deg);
  }

  .a {
    padding-bottom: var(--s5);
  }

  .a p {
    color: var(--ink);
    max-width: 68ch;
  }

  @media (hover: hover) {
    summary:hover .q {
      color: var(--link);
    }
  }

  /* The focus ring goes on the summary, which is the focusable element. */
  summary:focus-visible {
    outline: 2px solid var(--accent-press);
    outline-offset: 2px;
  }

  @media (min-width: 700px) {
    summary {
      padding-block: var(--s5);
    }

    .q {
      font-size: var(--d3);
    }
  }
</style>