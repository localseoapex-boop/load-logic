---
/**
 * BaseLayout.astro — the root HTML shell every page renders inside.
 *
 * Composes the global pieces: BaseHead (SEO meta), the header, the footer, the
 * sticky mobile action bar, and the LocalBusiness schema. It forwards SEO props
 * through to BaseHead so each page controls its own title/description/canonical
 * while inheriting one consistent document structure.
 *
 * The specialized templates (Service/City/BlogPost) build ON TOP of this layout,
 * so global concerns live here and only here.
 *
 * STYLING: this layout loads only tokens.css and base.css. The old 563-line
 * global block moved to src/styles/legacy.css, which the not-yet-rebuilt
 * templates import themselves. Every new component styles itself in a scoped
 * <style> block, so there is no global cascade to collide with.
 */
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyActionBar from '../components/StickyActionBar.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { SITE } from '../config/site';

import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Hide the sticky mobile action bar. Only for pages that ARE the conversion
   * step, where a floating "Get a Photo Quote" would point at the page you are
   * already on.
   */
  hideActionBar?: boolean;
}

const { title, description, image, type, noindex, hideActionBar = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {title} {description} {image} {type} {noindex} />
    <LocalBusinessSchema />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {!hideActionBar && <StickyActionBar />}

    <script>
      // The only site-wide script. Two jobs, both progressive enhancement.
      //
      // 1. Mark the document as scripted, which is what arms the scroll-reveal
      //    CSS. Without this class every [data-reveal] element renders visible,
      //    so a no-JS visitor sees the complete page rather than a blank one.
      // 2. Reveal sections as they enter the viewport, once each.
      document.documentElement.classList.add('js');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = document.querySelectorAll('[data-reveal]');

      if (reduced.matches || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));

        // Safety net. Content that has not been revealed within a few seconds is
        // shown regardless. An animation failing should never mean a visitor,
        // a crawler, or a screenshot tool sees a blank section.
        window.setTimeout(() => {
          targets.forEach((el) => el.classList.add('is-visible'));
          observer.disconnect();
        }, 4000);
      }
    </script>
  </body>
</html>
