---
/**
 * ServiceLayout2026.astro — the redesigned /services/[service] template.
 *
 * ─────────────────────────── Scope ───────────────────────────
 *
 * A VISUAL pass over the existing service page. Every section that ServiceLayout
 * rendered is rendered here, in the same order, with the same data from the same
 * sources. Nothing was added, nothing removed, and no copy was rewritten. What
 * changed is how each block is presented, plus the CTA bands between them.
 *
 * Running alongside the old template on purpose: the route picks this one for a
 * single slug so the design can be reviewed on one page before it reaches the
 * other thirteen. Rolling it out means adding slugs to that set, and reverting
 * means removing them.
 *
 * The old template stays because it still renders those thirteen pages, and it
 * still loads legacy.css. This page never sees that stylesheet: it is served
 * from its own static route file, so Astro bundles only this template's CSS with
 * it. Nothing here is braced against legacy rules, and nothing needs to be —
 * see pages/services/garage-cleanouts/index.astro for why the route is split.
 *
 * ────────────────────── What is reused from the homepage ──────────────────────
 *
 *   Section        numbered masthead, tone, scale, media slot
 *   CtaBreak       the compact conversion band
 *   HowItWorks     the four-step banner, reading the same serviceProcess data
 *                  this page already displayed
 *   QuoteCta       Get a Photo Quote + Call Now
 *   FaqBlock       the native <details> accordion
 *
 * The hero is deliberately NOT the homepage hero. The homepage runs a full-bleed
 * photographic background; this is a split — type on bone at the left, the
 * photograph filling the right column to the viewport edge. Same system, clearly
 * a different kind of page.
 *
 * ─────────────────────────── Schema ───────────────────────────
 *
 * Service, FAQPage and BreadcrumbList are emitted exactly as before, from the
 * same builders. FaqBlock is passed schema={false} because this layout already
 * emits the FAQPage node itself; two would be a duplicate.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import CtaBreak from '../components/CtaBreak.astro';
import QuoteCta from '../components/QuoteCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { Image, getImage } from 'astro:assets';
import { BUSINESS, SITE } from '../config/site';
import type { Service } from '../data/services';
import {
  getServiceContent,
  getServiceFaqs,
  whyChoose,
  serviceTrustBullets,
} from '../data/service-content';
import { relatedServices, locationsForService, subServicesForCategory } from '../lib/links';
import { serviceUrl, cityUrl, subServiceUrl, absoluteUrl } from '../lib/urls';

import { imagesForService } from '../data/service-images';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const content = getServiceContent(service.slug);
const faqs = getServiceFaqs(service.slug);

/*
 * Per-service photography. `hero` is required; `support` and `outcome` are
 * optional, and the sections they sit in render without them. Three images suit
 * a garage cleanout and would pad a mattress removal, so this is a deliberate
 * per-service decision rather than a template constant.
 */
const images = imagesForService(service.slug);

if (!images) {
  throw new Error(
    `No imagery registered for "${service.slug}". Add it to data/service-images.ts before moving this service onto ServiceLayout2026.`,
  );
}

// These are the canonical Mesa service pages — title targets Mesa explicitly.
const title = `${service.name} in Mesa, AZ`;
const description = service.description;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: service.name },
];

const subServiceLinks = subServicesForCategory(service.slug).map((sub) => ({
  label: sub.name,
  href: subServiceUrl(service.slug, sub.slug),
  description: sub.tagline,
}));

/* Cities linking to the city page, never to a per-city version of this one. */
const areaLinks = locationsForService(service.slug).map((loc) => ({
  label: `${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));

const relatedLinks = relatedServices(service.slug).map((s) => ({
  label: s.name,
  href: serviceUrl(s.slug),
  description: s.tagline,
}));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: BUSINESS.areaServed,
  description: service.description,
  url: absoluteUrl(serviceUrl(service.slug)),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

/*
 * Hero backgrounds, art directed per breakpoint.
 *
 * Two sources rather than one crop. The 4:3 frame suits the tall container a
 * phone gives the hero; a 16:9 frame suits the wide one a desktop gives it, and
 * is composed so the left third stays quiet where the copy sits. Serving one
 * file to both would either letterbox the subject on a phone or crop half its
 * height away on a desktop.
 */
const heroWideSrc = images.heroWide ?? images.hero;

const heroWide = await getImage({
  src: heroWideSrc.src,
  widths: [1024, 1440, 1920],
  format: 'webp',
});
const heroTall = await getImage({
  src: images.hero.src,
  widths: [480, 780, 1024],
  format: 'webp',
});

/** Lower-cased service name, as the existing final CTA copy used it. */
const lowerName = service.name.toLowerCase();

/*
 * Mid-page CTA copy, per service.
 *
 * The only new prose in this template. It is kept here rather than in
 * service-content.ts because it is conversion furniture, not service content —
 * nothing in it describes the service, and none of it appears in schema.
 *
 * One line each, phrased as the question the visitor is already asking at that
 * point in the page. The fallback covers any service not listed so a new
 * service never ships with an empty band.
 */
const CTA_COPY: Record<string, { ask: string; body: string }> = {
  'junk-removal': {
    ask: 'Not sure how much you have?',
    body: 'Send a few photos and we will size the job for you.',
  },
  'furniture-removal': {
    ask: 'Want to know what your furniture pickup will cost?',
    body: 'Send a photo of the pieces and we will come back with a price.',
  },
  'appliance-removal': {
    ask: 'Have an appliance ready to go?',
    body: 'Send us a photo and we will confirm the price and the pickup window.',
  },
  'garage-cleanouts': {
    ask: 'Want to know what your garage cleanout will cost?',
    body: "Send us a few photos and we'll help estimate the job.",
  },
  'estate-cleanouts': {
    ask: 'Not sure how large the cleanout is?',
    body: 'Send a few photos of the rooms and we will estimate it from there.',
  },
  'hot-tub-removal': {
    ask: 'Have a hot tub that needs to go?',
    body: 'Send a photo of the spa and the access to it and we will quote the job.',
  },
  'construction-debris-removal': {
    ask: 'Have debris piled up from a project?',
    body: 'Send a photo of the pile and we will tell you what it takes to clear it.',
  },
  'yard-waste-removal': {
    ask: 'Have a pile ready to go?',
    body: 'Send us a photo and we will come back with a price.',
  },
  'mattress-removal': {
    ask: 'Just need a mattress gone?',
    body: 'Send a photo and we will confirm the price before we come out.',
  },
  'shed-removal': {
    ask: 'Have a shed that needs to come down?',
    body: 'Send photos of the shed and what is still inside it.',
  },
  'hoarder-cleanouts': {
    ask: 'Not sure where to start?',
    body: 'Send a few photos when you are ready and we will take it from there.',
  },
  'office-cleanouts': {
    ask: 'Clearing an office or a suite?',
    body: 'Send photos of the space and we will quote the whole clearance.',
  },
  'foreclosure-cleanouts': {
    ask: 'Need a property cleared quickly?',
    body: 'Send photos of what is left behind and we will price the clearance.',
  },
  'same-day-junk-removal': {
    ask: 'Need it gone today?',
    body: 'Send photos early and we will tell you what we can fit in.',
  },
};

const cta = CTA_COPY[service.slug] ?? {
  ask: `Want to know what your ${lowerName} will cost?`,
  body: 'Send us a few photos and we will help estimate the job.',
};

/** Closing mid-page band: short, and specific to the outcome, not the service. */
const CTA_SECOND: Record<string, string> = {
  'garage-cleanouts': 'Ready to get the garage back?',
  'yard-waste-removal': 'Ready to get the yard back?',
  'office-cleanouts': 'Ready to hand the space back?',
  'shed-removal': 'Ready to get the footprint back?',
};

const ctaSecond = CTA_SECOND[service.slug] ?? 'Ready to clear the space?';
---

<BaseLayout {title} {description}>
  <div class="container container-wide crumbs">
    <Breadcrumbs items={crumbs} />
  </div>

  {/* ── Hero. A full-width photographic background with the message layered
       over it. The content is unchanged from the split version it replaces —
       eyebrow, H1, the tagline lede, both conversion actions and the existing
       trust bullets — only the composition changed. ── */}
  <header class="hero">
    <div class="hero-media" aria-hidden="true">
      <picture>
        <source media="(min-width: 768px)" srcset={heroWide.srcSet.attribute} sizes="100vw" />
        <img
          src={heroTall.src}
          srcset={heroTall.srcSet.attribute}
          sizes="100vw"
          alt=""
          width={heroTall.attributes.width}
          height={heroTall.attributes.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="scrim"></div>
    </div>

    <div class="container container-wide hero-inner">
      <p class="eyebrow">Junk Removal</p>
      <h1>{service.name} in Mesa &amp; the East Valley</h1>
      <p class="lede">{service.tagline}</p>
      <div class="hero-cta">
        <QuoteCta size="lg" source={`service-${service.slug}-hero`} onDark />
      </div>
    </div>

    <div class="trust-rail">
      <div class="container container-wide">
        <ul class="trust">
          {serviceTrustBullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </header>

  {/* ── 01 Overview. No heading: the original section opened straight into the
       intro line with no <h2>, and adding one would put a heading in the outline
       that the page never had. The masthead carries the label instead. ── */}
  <Section index="01" label="Overview" width="wide">
    <div class="overview">
      <p class="intro-line">{service.intro}</p>
      <div class="copy">
        {(content?.overview ?? []).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </Section>

  {/* ── 02 What we offer + common reasons ── */}
  <Section index="02" label="Scope" tone="sunk" heading="What we offer" width="wide">
    <div class="offer">
      <ul class="ruled">
        {service.features.map((f) => <li>{f}</li>)}
      </ul>
      {
        content && content.reasons.length > 0 && (
          <div class="reasons">
            <h3>Common reasons customers call</h3>
            <ul class="chips">
              {content.reasons.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Section>

  {/* ── 03 What we take, with the packed-garage photograph beside the heading ── */}
  {
    content && content.detailGroups.length > 0 && (
      <Section index="03" label="Materials" heading="What we take" width="wide">
        {images.support && (
          <Image
            slot="media"
            src={images.support.src}
            alt={images.support.alt}
            widths={[420, 760]}
            sizes="(min-width: 900px) 42vw, 92vw"
            loading="lazy"
          />
        )}
        <ul class="groups">
          {content.detailGroups.map((group) => (
            <li>
              <h3>{group.title}</h3>
              <ul class="items">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>

        {content.specialNote && (
          <div class="special">
            <h3>Items that need special handling</h3>
            <p>{content.specialNote}</p>
          </div>
        )}
      </Section>
    )
  }

  <CtaBreak
    heading={cta.ask}
    body={cta.body}
    source={`service-${service.slug}-mid-1`}
  />

  {/* ── 04 How it works. The same serviceProcess steps this page already
       displayed, in the homepage's four-across banner. ── */}
  <Section index="04" label="Process" tone="sunk" weight="tight" heading="How it works" width="wide">
    <HowItWorks variant="booking" layout="banner" />
  </Section>

  {/* ── 05 Why choose Load Logic ── */}
  <Section index="05" label="Why Load Logic" heading="Why choose Load Logic" width="wide">
    <ul class="points">
      {
        whyChoose.map((w, i) => (
          <li>
            <span class="idx data" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{w}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ── 06 Problem / solution, with the cleared garage beside the heading ── */}
  {
    content && content.problems.length > 0 && (
      <Section
        index="06"
        label="Hard parts"
        tone="sunk"
        heading="We solve the hard part"
        width="wide"
      >
        {images.outcome && (
          <Image
            slot="media"
            src={images.outcome.src}
            alt={images.outcome.alt}
            widths={[420, 760]}
            sizes="(min-width: 900px) 42vw, 92vw"
            loading="lazy"
          />
        )}
        <ul class="problems">
          {content.problems.map((p) => (
            <li>
              <div class="side">
                <h3>Problem</h3>
                <p>{p.problem}</p>
              </div>
              <div class="side solution">
                <h3>Solution</h3>
                <p>{p.solution}</p>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <CtaBreak
    heading={ctaSecond}
    source={`service-${service.slug}-mid-2`}
    tone="dark"
  />

  {/* ── Internal links. Same three groups, rendered inline rather than through
       InternalLinks, which is shared with the location templates and is not
       being restyled in this pass. ── */}
  {/* No section heading here on purpose. These three groups carried their own
      <h2>s on the original page; giving the block a wrapper heading would have
      demoted them to <h3> and invented a heading the page never had. The
      masthead index and label do the wayfinding instead. */}
  <Section index="07" label="Where next" width="wide">
    <div class="link-groups">
      {
        subServiceLinks.length > 0 && (
          <div class="group">
            <h2>{service.name} options</h2>
            <ul>
              {subServiceLinks.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                  {l.description && <span>{l.description}</span>}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="group">
        <h2>Available in these areas</h2>
        <ul class="areas">
          {areaLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="group">
        <h2>Related services</h2>
        <ul>
          {relatedLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
              {l.description && <span>{l.description}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {/* ── 08 FAQs. schema={false}: this layout emits the FAQPage node itself. ── */}
  <Section
    index="08"
    label="FAQ"
    tone="sunk"
    scale="utility"
    heading={`${service.name} FAQs`}
    width="wide"
  >
    <FaqBlock faqs={faqs} schema={false} />
  </Section>

  {/* ── Final CTA. Existing heading and copy, restyled. ── */}
  <section class="final on-dark">
    <div class="container container-wide final-inner">
      <div>
        <h2>Ready to clear it out?</h2>
        <p>Get an upfront quote for {lowerName} in Mesa and the East Valley.</p>
      </div>
      <QuoteCta size="lg" source={`service-${service.slug}-final`} onDark />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</BaseLayout>

<style>
  .crumbs {
    padding-top: var(--s5);
  }

  /* ─────────────────────────── Hero ───────────────────────────
     A full-width photograph with the message on it. Two scrims: one weighted to
     the left where the copy sits, one to the bottom under the trust rail, both
     falling away toward the subject so the photograph stays a photograph rather
     than becoming a dark block with text on it. */

  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: min(78dvh, 560px);
    isolation: isolate;
    background: var(--dark);
    color: #fff;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* <picture> is display:inline by default, so a percentage height on the <img>
     would resolve against the picture box rather than against .hero-media. */
  .hero-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(24 26 28 / 0.84) 0%,
        rgb(24 26 28 / 0.66) 32%,
        rgb(24 26 28 / 0.26) 64%,
        rgb(24 26 28 / 0.06) 100%
      ),
      linear-gradient(
        to top,
        rgb(24 26 28 / 0.72) 0%,
        rgb(24 26 28 / 0.3) 30%,
        rgb(24 26 28 / 0.04) 62%,
        rgb(24 26 28 / 0.1) 100%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-block: var(--s8) var(--s7);
    max-width: var(--w-wide);
  }

  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: var(--s4);
  }

  h1 {
    font-size: var(--d1);
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 16ch;
    color: #fff;
    text-shadow: 0 2px 24px rgb(24 26 28 / 0.5);
  }

  .lede {
    margin-top: var(--s5);
    font-size: var(--t1);
    color: rgb(255 255 255 / 0.9);
    max-width: 46ch;
    text-shadow: 0 1px 16px rgb(24 26 28 / 0.55);
  }

  .hero-cta {
    margin-top: var(--s6);
  }

  /* The secondary button's dark treatment is transparent with a dim border,
     which is right on a solid block and too weak over a photograph — the label
     sits on mid-tone driveway with almost nothing separating it. Scoped to the
     hero so the button behaves normally everywhere else. No backdrop-filter:
     this layer scrolls, and blur on a scrolling layer costs repaints. */
  .hero-cta :global(.btn.dark.solid) {
    background: rgb(24 26 28 / 0.55);
    border-color: rgb(255 255 255 / 0.5);
    color: #fff;
  }

  .hero-cta :global(.btn.dark.solid:hover) {
    background: rgb(24 26 28 / 0.74);
    border-color: #fff;
  }

  /* The existing trust bullets, kept and moved to a rail along the bottom edge
     so they read as operating facts over the photograph rather than as a list
     floating on it. */
  .trust-rail {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(24 26 28 / 0.4);
    padding-block: var(--s4);
  }

  .trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s2) var(--s6);
  }

  .trust li {
    font-size: var(--t3);
    color: rgb(255 255 255 / 0.86);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: min(74dvh, 600px);
    }

    .hero-media img {
      object-position: center 58%;
    }

    .hero-inner {
      padding-block: var(--s9) var(--s8);
    }

    .trust {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: var(--s8);
    }

    .trust-rail {
      padding-block: var(--s5);
    }
  }

  /* Below the breakpoint the left-weighted gradient would darken the whole
     narrow frame, so the vertical one carries it alone. */
  @media (max-width: 767px) {
    .scrim {
      background: linear-gradient(
        to top,
        rgb(24 26 28 / 0.88) 0%,
        rgb(24 26 28 / 0.7) 32%,
        rgb(24 26 28 / 0.36) 62%,
        rgb(24 26 28 / 0.46) 100%
      );
    }

    .hero-inner {
      align-self: end;
    }
  }

  /* ─────────────────────── 01 Overview ─────────────────────── */

  .intro-line {
    font-size: var(--d3);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .copy {
    display: grid;
    gap: var(--s4);
  }

  .copy p {
    color: var(--ink-2);
    max-width: 68ch;
  }

  @media (min-width: 900px) {
    /* Long-form copy set against the intro line rather than beneath it, so the
       section reads as two columns instead of one narrow stack. */
    .overview {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s9);
      align-items: start;
    }
  }

  /* ─────────────────────── 02 What we offer ─────────────────────── */

  .ruled {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .ruled li {
    padding-block: var(--s3);
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
  }

  .reasons h3 {
    font-size: var(--t2);
    margin-bottom: var(--s4);
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .chips li {
    font-size: var(--t3);
    padding: var(--s1) var(--s3);
    border: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }

  .reasons {
    margin-top: var(--s7);
  }

  @media (min-width: 900px) {
    .offer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s9);
      align-items: start;
    }

    .reasons {
      margin-top: 0;
    }
  }

  /* ─────────────────────── 03 What we take ─────────────────────── */

  .groups {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s6);
    border-top: 2px solid var(--ink);
    padding-top: var(--s5);
  }

  .groups > li h3 {
    font-size: var(--d3);
    letter-spacing: 0;
  }

  .items {
    list-style: none;
    padding: 0;
    margin-top: var(--s3);
    display: grid;
    gap: var(--s2);
  }

  .items li {
    font-size: var(--t3);
    color: var(--ink-2);
    padding-block: var(--s2);
