---
/**
 * CityLayout2026.astro — the /locations/[city] template.
 *
 * ─────────────────────────── Structure ───────────────────────────
 *
 * Thirteen sections in a fixed order, per the owner's city-page specification:
 *
 *   hero → local introduction → services → process → why choose → CTA band →
 *   what we haul → property types → pricing → reviews → areas + map → FAQs →
 *   final CTA
 *
 * One reusable template drives every city. Everything city-specific comes from
 * locations.ts (intro, localIntro, neighborhoods, nearby, propertyMix,
 * accessNotes) and from resolvers over the shared catalogs — there are no
 * per-city page files and no city-swapped filler paragraphs.
 *
 * ───────────────────── Where the local content comes from ─────────────────────
 *
 * The differentiation rule for these pages: a section shows REAL local data or
 * it shows shared content under a local heading, and nothing in between.
 *
 *   intro          unique per city (hero lede)
 *   localIntro     per-city paragraphs written from that city's own data
 *   accessNotes    operationally true local details, surfaced in the intro
 *   propertyMix    which buyers dominate this market — drives Property Types
 *   neighborhoods  real communities, listed in Areas We Serve
 *   nearby         real sibling cities, linked and mapped
 *   FAQs           shared answers from faqs.ts plus one genuinely local
 *                  question generated from the neighborhoods/nearby data,
 *                  plus any city-scoped entries via faqsForCity()
 *
 * ─────────────────────────── CTA labels ───────────────────────────
 *
 * City pages use "Schedule Now" as the primary label at the owner's explicit
 * instruction — the one sanctioned departure from the site-wide "Get a Photo
 * Quote" lock. The DESTINATIONS never change: primary is /quote, secondary is
 * tel:. See QuoteCta.astro.
 *
 * ─────────────────────────── Reviews ───────────────────────────
 *
 * The reviews section renders Testimonials, the same component the homepage
 * uses. TODO: the quotes it currently shows are the approved PLACEHOLDER set
 * from reviews.ts (isPlaceholder: true) — temporary display content so the
 * section can be evaluated, never presented as verified and never given
 * Review/AggregateRating schema. The moment a real review lands in reviews.ts
 * with `verified: true`, Testimonials switches to the verified set on its own;
 * replacing the placeholders requires no change here.
 *
 * ─────────────────────────── Honesty ───────────────────────────
 *
 * Nothing here claims an office, an address, a tenure or a customer count in
 * this city. Each page is written city-first: the target city is the subject,
 * and Mesa appears only where it is legitimate geography (the coverage map's
 * home-base marker and the site chrome). The hero
 * photograph is Arizona suburban context, not a photograph of the named city,
 * and its alt text never names one.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import CtaBreak from '../components/CtaBreak.astro';
import QuoteCta from '../components/QuoteCta.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyChoose from '../components/WhyChoose.astro';
import MaterialOverview from '../components/MaterialOverview.astro';
import LoadSizeScale from '../components/LoadSizeScale.astro';
import PropertyTypes from '../components/PropertyTypes.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { Image, getImage } from 'astro:assets';
import type { Location } from '../data/locations';
import { getOffice, primaryOffice } from '../data/offices';
import { servicesForLocation, nearbyCities } from '../lib/links';
import { cityUrl, serviceUrl } from '../lib/urls';
import { getFaq, faqsForCity } from '../data/faqs';
import { getPropertyType, type PropertyType } from '../data/property-types';

import { heroForCity } from '../data/city-images';
import localImg from '../assets/photos/cities/ctx-suburb.jpg';
import serviceImg from '../assets/photos/loads/load-side.jpg';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const office = getOffice(location.officeId) ?? primaryOffice;
const cityState = `${location.city}, ${location.region}`;

const title = `Junk Removal in ${cityState}`;
const description = `Junk removal and cleanouts in ${cityState} — furniture, appliances, mattresses, garages, estates, and construction debris, with upfront pricing.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas We Serve', href: '/locations' },
  { name: cityState },
];

/* Services this city offers -> the ONE canonical page for each service. */
const serviceLinks = servicesForLocation(location).map((s) => ({
  label: s.name,
  href: serviceUrl(s.slug),
  description: s.tagline,
}));

const nearby = nearbyCities(location.slug);
const nearbyLinks = nearby.map((loc) => ({
  label: `Junk removal in ${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));

/*
 * The buyers who dominate THIS market, from locations.ts propertyMix. Each city
 * carries its own real mix — Tempe leads with renters and property managers,
 * Scottsdale with realtors — so this section differs between cities because the
 * data does, not because the copy was reshuffled. The fallback covers a future
 * city added before its mix is researched.
 */
const propertyMix = (
  location.propertyMix ?? ['homeowner', 'renter', 'landlord', 'realtor']
)
  .map(getPropertyType)
  .filter((t): t is PropertyType => Boolean(t));

/*
 * The city FAQ set. Six real answers from the shared FAQ bank — the questions a
 * city visitor actually asks: cost, what we take, whether things must be moved
 * outside, heavy material, where it all goes, and how fast we can come. Then one
 * question that is genuinely about THIS city, answered from the neighborhoods
 * and nearby-city data, one whole-property question composed from established
 * facts, and finally any city-scoped entries from faqs.ts.
 *
 * The generic questions are deliberately NOT retitled with the city name: the
 * answers are not city-specific, and pretending otherwise is exactly the
 * city-swapped filler these pages are built to avoid. The H2 carries the city.
 */
const sharedFaqSlugs = [
  'how-is-pricing-determined',
  'what-do-you-not-take',
  'do-i-need-to-move-things-outside',
  'do-you-take-heavy-material',
  'where-does-it-go',
  'how-quickly-can-you-come',
];

const areaAnswer = [
  `We serve all of ${location.city}`,
  location.neighborhoods && location.neighborhoods.length > 0
    ? `, including ${location.neighborhoods.join(', ')}`
    : '',
  '. We also cover the nearby ',
  nearby.map((n) => n.city).join(', '),
  ' areas. If you are not sure about an address, send the ZIP code with your quote request and we will confirm before anything is scheduled.',
].join('');

const cityFaqs = [
  ...sharedFaqSlugs
    .map(getFaq)
    .filter((f): f is NonNullable<ReturnType<typeof getFaq>> => Boolean(f))
    .map((f) => ({ question: f.question, answer: f.answer })),
  {
    question: 'Can you clean out an entire property?',
    answer:
      'Yes. Whole-property work is a core part of what we do — estate cleanouts, foreclosure cleanouts, and hoarder cleanouts are all handled room by room. Anything larger than one trailer load is planned as multiple trips and quoted together, and you approve the price before anything is loaded.',
  },
  {
    question: `What parts of ${location.city} do you serve?`,
    answer: areaAnswer,
  },
  ...faqsForCity(location.slug).map((f) => ({ question: f.question, answer: f.answer })),
];

/*
 * Hero from the regional library. Five concepts across nine cities, so the pages
 * are related without being identical — and no frame claims to depict the named
 * city, which generated photography cannot honestly do.
 */
const hero = heroForCity(location.slug);

const heroWide = await getImage({
  src: hero.wide,
  widths: [1024, 1440, 1920],
  format: 'webp',
});
const heroTall = await getImage({
  src: hero.tall,
  widths: [480, 780, 1024],
  format: 'webp',
});
---

<BaseLayout {title} {description}>
  <div class="container container-wide crumbs">
    <Breadcrumbs items={crumbs} />
  </div>

  {/* ── 1. Hero. Full-width photograph, H1, the city's unique value line, both
       conversion actions. ── */}
  <header class="hero">
    <div class="hero-media" aria-hidden="true" style={`--hero-focus: ${hero.focus}`}>
      <picture>
        <source media="(min-width: 768px)" srcset={heroWide.srcSet.attribute} sizes="100vw" />
        <img
          src={heroTall.src}
          srcset={heroTall.srcSet.attribute}
          sizes="100vw"
          alt=""
          width={heroTall.attributes.width}
          height={heroTall.attributes.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="scrim"></div>
    </div>

    <div class="container container-wide hero-inner">
      <p class="eyebrow">Serving {cityState}</p>
      <h1>{title}</h1>
      <p class="lede">{location.intro ?? description}</p>
      <div class="hero-cta">
        <QuoteCta size="lg" source={`city-${location.slug}-hero`} onDark label="Schedule Now" />
      </div>
    </div>
  </header>

  {/* ── 2. Local introduction. The shared who-we-are paragraph, any extended
       local copy from the data, and the city's real access notes — the most
       genuinely local information the project holds. ── */}
  <Section
    index="01"
    label={`In ${location.city}`}
    heading={`Your junk removal crew in ${location.city}`}
    width="wide"
  >
    <div class="local-row">
      <div class="local">
        <p class="local-lede">
          Load Logic provides full-service junk removal throughout {location.city}. We
          bring the truck and the muscle, give you an upfront price before we load,
          and clean up the area when the job is done — no dumpster rental, no heavy
          lifting on your end.
        </p>

        {location.localIntro?.map((para) => <p class="local-more">{para}</p>)}

        {
          location.accessNotes && location.accessNotes.length > 0 && (
            <div class="access">
              <p class="access-label">
                <strong>Working in {location.city}:</strong>
              </p>
              <ul class="access-list">
                {location.accessNotes.map((n) => (
                  <li>{n.note}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <figure class="local-media">
        <Image
          src={localImg}
          alt="A quiet East Valley residential street of single storey stucco homes with tile roofs and gravel front yards"
          widths={[420, 760, 1000]}
          sizes="(min-width: 900px) 44vw, 92vw"
          loading="lazy"
        />
      </figure>
    </div>
  </Section>

  {/* ── 3. Services. Every service that reaches this city, each linking to its
       own page. Never to a per-city version of it: those URLs are gone. ── */}
  <Section
    index="02"
    label="Service index"
    tone="sunk"
    heading={`Junk removal services in ${location.city}`}
    width="wide"
  >
    <Image
      slot="media"
      src={serviceImg}
      alt="An open utility trailer with mesh side rails loaded with boxes and household junk, hitched to a pickup truck on a driveway"
      widths={[420, 760]}
      sizes="(min-width: 900px) 42vw, 92vw"
      loading="lazy"
    />
    <ol class="directory">
      {
        serviceLinks.map((s, i) => (
          <li>
            <a href={s.href}>
              <span class="num data" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="name">{s.label}</h3>
              <span class="blurb">{s.description}</span>
              <span class="mark" aria-hidden="true">
                &#8594;
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ── 4. Process. The existing four steps in the existing banner, closing on
       the conversion action. ── */}
  <Section index="03" label="Process" weight="tight" heading="How it works" width="wide">
    <HowItWorks variant="quote" layout="banner" />
    <div class="process-cta">
      <QuoteCta source={`city-${location.slug}-process`} label="Schedule Now" />
    </div>
  </Section>

  {/* ── 5. Why choose Load Logic. The homepage's four supported differentiators,
       unchanged — every claim is one the project can stand behind. ── */}
  <Section index="04" label="Why Load Logic" tone="sunk" heading="Why choose Load Logic">
    <WhyChoose localScope="east-valley" />
  </Section>

  {/* ── 6. Mid-page CTA band. ── */}
  <CtaBreak
    heading="Ready to clear out your junk?"
    body="Send us a few photos and we'll help estimate the job."
    source={`city-${location.slug}-mid`}
    tone="dark"
    ctaLabel="Schedule Now"
  />

  {/* ── 7. What we haul away. The eight material categories with recognisable
       examples, from the same catalog the whole site reads. ── */}
  <Section
    index="05"
    label="Materials"
    heading="What we haul away"
    intro="If it fits on the trailer and it is legal to haul, it goes. Here is the shape of it."
    width="wide"
  >
    <MaterialOverview />
  </Section>

  {/* ── 8. Property types. This market's real buyer mix from locations.ts —
       use cases, not another service list. ── */}
  <Section
    index="06"
    label="Who we help"
    tone="sunk"
    heading={`Junk removal for every kind of property in ${location.city}`}
    width="wide"
  >
    <PropertyTypes types={propertyMix} />
  </Section>

  {/* ── 9. Pricing. The load scale and starting prices from pricing.ts — the
       single source of truth — with the same short honest framing the homepage
       uses, and the depth on /pricing. ── */}
  <Section
    index="07"
    label="Pricing"
    tone="white"
    heading={`Junk removal pricing in ${location.city}`}
    intro="Price follows volume. Find the closest match and you have the starting figure for a job that size."
    width="wide"
  >
    <LoadSizeScale layout="grid" />
    <div class="price-notes">
      <p class="price-lede">
        Final pricing depends on volume, material, access and labor. Send us photos
        for a more accurate quote.
      </p>
      <p class="price-heavy">
        Concrete, dirt, tile and other dense materials are quoted separately based
        on weight.
      </p>
      <p class="section-link">
        <a href="/pricing">See full pricing details</a>
      </p>
      <div class="price-cta">
        <QuoteCta source={`city-${location.slug}-pricing`} label="Schedule Now" />
      </div>
    </div>
  </Section>

  {/* ── 10. Reviews. Testimonials renders the site's review state: TODO — the
       current quotes are the approved PLACEHOLDER set (reviews.ts, isPlaceholder:
       true) and must be replaced with verified customer reviews. No Review or
       AggregateRating schema is emitted for them, no star ratings, no platform
       names. Once a `verified: true` review exists the component switches to the
       real set automatically. ── */}
  <Section index="08" label="Reviews" tone="sunk" heading="What customers say" width="wide">
    <Testimonials />
  </Section>

  {/* ── 11. Areas we serve. The city's real communities, the nearby cities as
       crawlable links, and the coverage map drawn from real coordinates with
       this city marked. ── */}
  <Section
    index="09"
    label="Coverage"
    heading={`Areas we serve around ${location.city}`}
    width="wide"
  >
    {
      location.neighborhoods && location.neighborhoods.length > 0 && (
        <div class="areas">
          <p class="areas-label">
            <strong>Areas we serve in {location.city}:</strong>
          </p>
          <ul class="areas-list">
            {location.neighborhoods.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="area-cols">
      <ul class="nearby">
        {
          nearbyLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="area-map">
        <ServiceAreaMap highlight={location.slug} />
      </div>
    </div>
  </Section>

  {/* ── 12. FAQs. Real answers from the shared bank plus the genuinely local
       serve-area question. FaqBlock emits the FAQPage schema from the same
       array it renders, so the two cannot diverge. ── */}
  <Section
    index="10"
    label="FAQ"
    tone="sunk"
    scale="utility"
    heading={`Junk removal FAQs in ${location.city}`}
    width="wide"
  >
    <FaqBlock faqs={cityFaqs} />
  </Section>

  {/* ── 13. Final CTA. ── */}
  <section class="final on-dark">
    <div class="container container-wide final-inner">
      <div>
        <h2>Need junk gone in {location.city}?</h2>
        <p>Call or send a few photos for a fast, upfront quote.</p>
      </div>
      <QuoteCta
        size="lg"
        source={`city-${location.slug}-final`}
        onDark
        label="Schedule Now"
        callLabel="Call Load Logic"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    padding-top: var(--s5);
  }

  /* ─────────────────────────── Hero ─────────────────────────── */

  .hero {
    position: relative;
    display: grid;
    min-height: min(70dvh, 520px);
    isolation: isolate;
    background: var(--dark);
    color: #fff;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* <picture> is display:inline by default, so a percentage height on the <img>
     would resolve against the picture box rather than against .hero-media. */
  .hero-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The MOBILE default. The tall frames are composed subject-up / ground-down,
       so the crop favours the top. The per-concept focus below is for the wide
       frames, which are composed differently. */
    object-position: center 32%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(24 26 28 / 0.84) 0%,
        rgb(24 26 28 / 0.64) 34%,
        rgb(24 26 28 / 0.24) 66%,
        rgb(24 26 28 / 0.06) 100%
      ),
      linear-gradient(
        to top,
        rgb(24 26 28 / 0.62) 0%,
        rgb(24 26 28 / 0.24) 34%,
        rgb(24 26 28 / 0.04) 64%,
        rgb(24 26 28 / 0.12) 100%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-block: var(--s8);
    max-width: var(--w-wide);
  }

  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: var(--s4);
  }

  h1 {
    font-size: var(--d1);
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 15ch;
    color: #fff;
    text-shadow: 0 2px 24px rgb(24 26 28 / 0.5);
  }

  .lede {
    margin-top: var(--s5);
    font-size: var(--t1);
    color: rgb(255 255 255 / 0.9);
    max-width: 52ch;
    text-shadow: 0 1px 16px rgb(24 26 28 / 0.55);
  }

  .hero-cta {
    margin-top: var(--s6);
  }

  /* The secondary button is transparent with a dim border, which is right on a
     solid block and too weak over a photograph. Scoped to the hero. */
  .hero-cta :global(.btn.dark.solid) {
    background: rgb(24 26 28 / 0.55);
    border-color: rgb(255 255 255 / 0.5);
    color: #fff;
  }

  .hero-cta :global(.btn.dark.solid:hover) {
    background: rgb(24 26 28 / 0.74);
    border-color: #fff;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: min(66dvh, 540px);
    }

    /* Per-concept, from city-images.ts: the wide frames place their subject at
       different heights and a shared value loses it on some of them. */
    .hero-media img {
      object-position: var(--hero-focus, center 58%);
    }

    .hero-inner {
      padding-block: var(--s9);
    }
  }

  /* ── Mobile: the photograph leads, the copy sits under it ──
     Measured white-on-composite contrast behind the intro at 390px was 2.7:1 on
     the brightest frame and below WCAG AA on five of the nine cities. A heavier
     scrim would erase the photograph, and a copy plate could only ever leave sky
     showing (a 3:4 source in a 390px container scales by height, so
     object-position has no vertical travel). So on a phone the hero splits: the
     photograph gets its own band, the copy sits beneath it on solid spruce. */
  @media (max-width: 767px) {
    .hero {
      display: block;
      min-height: 0;
    }

    .hero-media {
      position: relative;
      inset: auto;
      height: auto;
    }

    .hero-media picture,
    .hero-media img {
      height: auto;
    }

    .hero-media img {
      aspect-ratio: 4 / 3;
      object-position: center 62%;
    }

    /* The gradient is only needed where type sits on the image, and none does
       now. A light foot keeps the band from butting hard into the block. */
    .scrim {
      background: linear-gradient(
        to top,
        rgb(24 26 28 / 0.35) 0%,
        rgb(24 26 28 / 0.06) 26%,
        rgb(24 26 28 / 0) 55%
      );
    }

    .hero-inner {
      max-width: none;
      margin-inline: 0;
      padding-inline: var(--gutter);
      padding-block: var(--s7) var(--s8);
      border-top: 3px solid var(--accent);
    }

    .hero-inner h1,
    .hero-inner .lede {
      text-shadow: none;
    }
  }

  /* ─────────────────── 01 Local introduction ─────────────────── */

  .local-row {
    display: grid;
    gap: var(--s7);
  }

  .local-media {
    margin: 0;
  }

  .local-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-flat);
  }

  @media (min-width: 900px) {
    .local-row {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--s9);
      align-items: start;
    }
  }

  .local-lede {
    font-size: var(--t1);
    color: var(--ink);
    max-width: 58ch;
    text-wrap: pretty;
  }

  .local-more {
    margin-top: var(--s4);
    color: var(--ink-2);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* The access notes: operationally true local detail, set as a small ruled
     list in the data register so it reads as field knowledge, not marketing. */
  .access {
    margin-top: var(--s6);
  }

  .access-label {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .access-label strong {
    font-weight: 700;
    color: var(--ink-3);
  }

  .access-list {
    list-style: none;
    padding: 0;
    margin-top: var(--s3);
    border-top: 2px solid var(--ink);
  }

  .access-list li {
    padding-block: var(--s3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--t3);
    color: var(--ink-2);
    max-width: 58ch;
  }

  /* ─────────────────── 02 Service directory ─────────────────── */

  .directory {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .directory li {
    border-bottom: 1px solid var(--rule);
  }

  .directory a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.25rem;
    grid-template-areas:
      'num name mark'
      'num blurb blurb';
    column-gap: var(--s3);
    align-items: baseline;
    padding-block: var(--s4);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur) var(--ease);
  }

  .num {
    grid-area: num;
    font-size: var(--t3);
    font-weight: 700;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur) var(--ease);
  }

  /* An h3 for structure; sized as the row title it visually is. */
  .name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--t1);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
