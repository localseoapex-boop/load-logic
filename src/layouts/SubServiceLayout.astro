---
/**
 * SubServiceLayout.astro — template for /services/[category]/[subservice] (req #3).
 *
 * Data-driven from a parent Service + a SubService. Builds a 4-level breadcrumb
 * (Home › Services › Category › Sub-service, req #7), Service JSON-LD scoped to
 * the sub-service (req #8), and internal links to sibling sub-services and to
 * this sub-service in each city that offers the parent category.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { BUSINESS, SITE } from '../config/site';
import type { Service } from '../data/services';
import type { SubService } from '../data/subservices';
import { subServicesForCategory, locationsForService } from '../lib/links';
import { serviceUrl, subServiceUrl, cityUrl, absoluteUrl } from '../lib/urls';
import Button from '../components/Button.astro';

interface Props {
  service: Service;
  subService: SubService;
}

const { service, subService } = Astro.props;

const title = subService.name;
const description = subService.description;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: service.name, href: serviceUrl(service.slug) },
  { name: subService.name },
];

// Sibling sub-services within the same category.
const siblingLinks = subServicesForCategory(service.slug)
  .filter((s) => s.slug !== subService.slug)
  .map((s) => ({ label: s.name, href: subServiceUrl(service.slug, s.slug), description: s.tagline }));

/*
 * Every city that offers the parent category, linking to the city page.
 *
 * This previously pointed at /locations/[city]/[service]/[subservice], which no
 * longer exists: those 18 URLs were the deepest layer of the city x service
 * fan-out and said nothing the city page and this page do not already say.
 */
const areaLinks = locationsForService(service.slug).map((loc) => ({
  label: `${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: subService.name,
  category: service.name,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: BUSINESS.areaServed,
  url: absoluteUrl(subServiceUrl(service.slug, subService.slug)),
};
---

<BaseLayout {title} {description}>
  <article class="container page">
    <Breadcrumbs items={crumbs} />

    <header class="page-hero">
      <p class="eyebrow">{service.name}</p>
      <h1>{subService.name}</h1>
      <p class="lede">{subService.tagline}</p>
      <div class="hero-cta">
        <Button href={`tel:${BUSINESS.phone}`}>Get a free quote — {BUSINESS.phoneDisplay}</Button>
      </div>
    </header>

    <div class="page-body">
      <p>{subService.intro}</p>
      <h2>What's included</h2>
      <ul class="check-list">
        {subService.features.map((f) => <li>{f}</li>)}
      </ul>
      <slot />
    </div>

    <InternalLinks title={`More ${service.name} services`} links={siblingLinks} />
    <InternalLinks title={`${subService.name} in your area`} links={areaLinks} />

    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  </article>
</BaseLayout>

<style>
  /* Migrated off legacy.css: the same markup, styled by the current system.
     Same classes, same content, same URLs — only the stylesheet moved. */
  .page {
    padding-block: var(--s5) var(--s8);
  }

  .page-hero {
    padding-block: var(--s6) var(--s7);
  }

  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--lbl);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-3);
    margin: 0 0 var(--s3);
  }

  .page-hero h1 {
    margin: 0 0 var(--s3);
  }

  .lede {
    font-size: var(--t1);
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 var(--s5);
  }

  .page-body {
    max-width: 72ch;
    margin-bottom: var(--s7);
  }

  .page-body h2 {
    margin: var(--s6) 0 var(--s4);
  }

  .check-list {
    list-style: none;
    display: grid;
    gap: 0;
    margin: var(--s4) 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .check-list li {
    position: relative;
    padding: var(--s3) 0 var(--s3) var(--s6);
    border-bottom: 1px solid var(--rule);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 1.05em;
    width: 9px;
    height: 5px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  @media (min-width: 700px) {
    .check-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s7);
    }

    .check-list li:nth-child(-n + 2) {
      border-top: 0;
    }
  }
</style>
