---
/**
 * LegalLayout.astro — the shell for the policy pages.
 *
 * Privacy and Terms are the same shape: a title, a last-updated stamp, and a
 * column of prose with headings. One layout so the two cannot drift apart
 * visually, and so a third policy page costs nothing to add.
 *
 * These pages are PUBLIC and indexable on purpose. Carrier and platform review
 * for A2P 10DLC has to be able to reach them without a login, and the consent
 * checkbox on the quote form links straight here.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** Shown under the heading, and the date the wording last changed. */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="legal-page">
    <div class="container container-narrow">
      <header class="head">
        <h1>{title}</h1>
        <p class="updated">Last updated {updated}</p>
      </header>

      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--s8) var(--s10);
  }

  .head {
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s7);
  }

  .updated {
    margin-top: var(--s3);
    font-family: var(--font-data);
    font-size: var(--t3);
    color: var(--ink-3);
  }

  /* One readable column. Headings carry the structure, rules do the separating,
     which is the same register the rest of the site uses for documents. */
  .prose :global(h2) {
    margin-top: var(--s7);
    margin-bottom: var(--s3);
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
    font-size: var(--d3);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose :global(h3) {
    margin-top: var(--s5);
    margin-bottom: var(--s2);
    font-size: var(--t1);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-2);
    max-width: var(--w-prose);
  }

  .prose :global(p) {
    margin-top: var(--s3);
  }

  .prose :global(ul) {
    margin-top: var(--s3);
    padding-inline-start: var(--s5);
    display: grid;
    gap: var(--s2);
  }

  .prose :global(li) {
    list-style: disc;
  }

  .prose :global(a) {
    font-weight: 600;
  }

  .prose :global(strong) {
    color: var(--ink);
  }
</style>
