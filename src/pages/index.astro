---
/**
 * Homepage — nine sections, restructured around Understand, Trust, Estimate, Convert.
 *
 * The complete build was eighteen sections and 25,857px at 390px, about 31
 * screens. That was deliberate: build everything, see the whole system, then cut
 * with evidence. This is the cut.
 *
 * ─────────────── What the homepage is now responsible for ───────────────
 *
 * Answering, in order, quickly enough that a homeowner can scan it one-handed:
 * what Load Logic does, whether they take your thing, how much you have, how
 * pricing works, why people call, that the work is real, what happens next,
 * where they operate, and how to ask.
 *
 * It is NOT responsible for displaying the knowledge graph. Depth now lives on
 * /pricing, the service pages, the location pages and /knowledge.json, and the
 * homepage routes intent to them through ordinary crawlable links.
 *
 * ─────────────────────── What that means for SEO ───────────────────────
 *
 * The entity relationships a crawler or an assistant needs are all still stated
 * in the HTML: the business, its services, the material categories it handles,
 * its service area with real ZIP codes, its pricing model, its equipment and its
 * quote action. Every service and every city keeps a plain anchor.
 *
 * The homepage no longer lists all 88 individual materials. That inventory is
 * business knowledge rather than homepage content: it lives in the graph, in
 * /knowledge.json and on the pages that own each material relationship. What the
 * homepage states is the category level, which is what a person and an assistant
 * both need in order to know whether to keep reading.
 *
 * Headings name their subject in plain language, so the page structure reads the
 * same way to a person and to a parser.
 *
 * FROM THE ORIGINAL HOMEPAGE, kept because they were better:
 *   the four operating facts, the four-step booking process, and the named
 *   service list with a one-line explanation of each.
 *
 * MERGED:   item categories + search + exclusions -> one overview section
 *           before/after + example job + equipment -> one proof section
 *           situations + service rail            -> one service directory
 *           disposal                              -> final step of How it works
 * REMOVED:  the DIY comparison, the standalone quote strip, the standalone
 *           service rail, the standalone exclusions and disposal sections.
 *           Every one of those components still exists and stays reusable.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import MaterialOverview from '../components/MaterialOverview.astro';
import LoadSizeScale from '../components/LoadSizeScale.astro';
import PricingLedger from '../components/PricingLedger.astro';
import ServiceDirectory from '../components/ServiceDirectory.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ExampleJob from '../components/ExampleJob.astro';
import EquipmentCapability from '../components/EquipmentCapability.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import ReviewWall from '../components/ReviewWall.astro';
import TrustFacts from '../components/TrustFacts.astro';
import FaqBlock from '../components/FaqBlock.astro';
import FinalQuoteCta from '../components/FinalQuoteCta.astro';

import { SITE, BUSINESS, hasVerifiedFacts } from '../config/site';
import { confirmedCapacityCubicYards } from '../data/equipment';
import { getJob } from '../data/jobs';
import { hasVerifiedReviews } from '../data/reviews';
import { getFaq } from '../data/faqs';

import { Image } from 'astro:assets';
import baGarageBefore from '../assets/photos/before-after/ba-garage-before.jpg';
import baGarageAfter from '../assets/photos/before-after/ba-garage-after.jpg';

/*
 * Homepage photography. Three of these were generated for this pass; the rest
 * already existed from phase 3 and were sitting unused, so they are reused
 * rather than regenerated. Every one is documentary service imagery: no
 * generated person is presented as the Load Logic team, and no frame shows more
 * than the one truck and one trailer the business actually runs.
 */
import imgStaged from '../assets/photos/equipment/equip-sorting.jpg';
import imgLoadSide from '../assets/photos/loads/load-side.jpg';
import imgServiceGarage from '../assets/photos/services/svc-garage.jpg';
import imgProofLoaded from '../assets/photos/home/proof-loaded.jpg';
import imgQuotePhoto from '../assets/photos/home/quote-photo.jpg';
import imgSuburb from '../assets/photos/cities/ctx-suburb.jpg';

/**
 * Six questions, chosen for decision value rather than coverage: price, what is
 * taken, how a quote works, timing, heavy material, and whether anything has to
 * be moved outside first. Everything else belongs on the page that owns it.
 */
const homeFaqs = [
  'how-is-pricing-determined',
  'what-do-you-not-take',
  'can-i-send-photos',
  'how-quickly-can-you-come',
  'do-you-take-heavy-material',
  'do-i-need-to-move-things-outside',
]
  .map(getFaq)
  .filter((f): f is NonNullable<typeof f> => Boolean(f))
  .map((f) => ({ question: f.question, answer: f.answer }));

const featureJob = getJob('gilbert-garage-reset');

/**
 * Restored verbatim from the original homepage, where they were the strongest
 * thing above the fold. Each is a description of how the service operates rather
 * than a claim that needs checking: the pricing model is volume based, the
 * service is full-service so no dumpster is involved, and disposal.ts really
 * does order donation and recycling ahead of landfill.
 */
const operatingFacts = [
  'Upfront, volume-based quotes',
  'No dumpster rental needed',
  'Full-service loading and hauling',
  'Donation and recycling first',
];

/**
 * The hero's operating rail. Four facts a dispatcher would actually state, and
 * every one is checkable: the home city, the real single-trip capacity from
 * equipment.ts (the larger of the two trailers, never their sum, because only
 * one can be towed at a time), the published minimum from pricing.ts, and the
 * business phone number.
 */
const heroFacts = [
  { label: 'Base', value: 'Mesa, AZ' },
  { label: 'Per trip', value: `${confirmedCapacityCubicYards()} yd³` },
  { label: 'Minimum', value: '$85' },
  { label: 'Dispatch', value: BUSINESS.phoneDisplay },
];

const showReviews = hasVerifiedReviews();
const showTrust = hasVerifiedFacts();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- 1. Hero. Four text elements, both CTAs, no explanatory copy above the fold. -->
  <Hero
    eyebrow="Junk removal in Mesa and the East Valley"
    heading="Point at it. We carry it out."
    subhead="Furniture, appliances, garages and full property cleanouts. Send photos and get a price before anything is loaded."
    alt="Two workers carrying a large sofa out through an open garage door and down a driveway"
    mobileAlt="A gloved hand gripping the wooden frame under a worn sofa as it is lifted"
    facts={heroFacts}
  />

  <!-- 1b. The four facts the original homepage led with. They answer "why you"
       in about three seconds and the redesign had dropped them entirely. They sit
       below the hero rather than inside it, which is where a trust strip belongs:
       these are operational descriptions of how the service works, not
       credentials, so nothing here needs verifying. -->
  <section class="facts">
    <div class="container container-wide">
      <ul>
        {operatingFacts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
  </section>

  <!-- 2. Discovery. Eight categories with recognisable examples, answering
       "do they take my kind of stuff" in a few seconds and then moving on. The
       full 88-item catalogue stays in the knowledge graph and in
       /knowledge.json rather than on the homepage. -->
  <Section
    index="01"
    label="Materials"
    heading="What do you need gone?"
    intro="If it fits on the trailer and it is legal to haul, it goes. Here is the shape of it."
    id="what-we-take"
  >
    <Image
      slot="media"
      src={imgStaged}
      alt="Household furniture and belongings staged on a driveway ready to be loaded"
      widths={[420, 760]}
      sizes="(min-width: 900px) 42vw, 92vw"
      loading="lazy"
    />
    <MaterialOverview />
  </Section>

  <!-- 3. How much, and what that costs. Merged, because the customer asks these
       as one question: how much junk do I have, and what will that run me. The
       scale already carries the prices, so the ledger beneath only covers what
       else moves the number, with the volume point omitted as redundant. -->
  <Section
    index="02"
    label="Load size / Pricing"
    tone="white"
    scale="display"
    weight="feature"
    heading="How much junk do you have?"
    intro="Price follows volume, so find the closest match and you already have a range. The minimum is $85."
    width="wide"
  >
    <Image
      slot="media"
      src={imgLoadSide}
      alt="An open utility trailer with mesh side rails loaded with boxes and household junk, hitched to a pickup truck on a driveway"
      widths={[420, 760]}
      sizes="(min-width: 900px) 42vw, 92vw"
      loading="lazy"
    />
    <LoadSizeScale />

    <div class="pricing-note">
      <h3>What else moves the price</h3>
      {/* The scale's footer already states the minimum, the multiple-load rule
          and the price-approval commitment, so only the factors it does not
          cover appear here. */}
      <PricingLedger variant="brief" omit={['volume', 'loads', 'approve']} />
      <p class="section-link">
        <a href="/pricing">Every pricing factor, worked examples and the do-it-yourself comparison</a>
      </p>
    </div>
  </Section>

  <!-- 4. What Load Logic actually offers. Restores the original homepage's
       clearest feature, a named service with a one-line explanation of what it
       is for, in a ruled directory rather than fourteen equal cards.
       This REPLACES the situations navigator: situations, a service directory
       and a related-services rail were three ways of saying the same thing, and
       the directory is the one that answers "what do you offer" directly. The
       Situations component stays in the codebase for service and location pages. -->
  <Section
    index="03"
    label="Service index"
    tone="sunk"
    heading="Junk removal services"
    intro="Fourteen services across homes, rentals and small commercial property. Every one links through to what it covers and what it costs."
    id="services"
  >
    <figure class="band">
      <Image
        src={imgServiceGarage}
        alt="A packed suburban garage filled with storage totes, shelving, bicycles and boxes"
        widths={[600, 1000, 1440]}
        sizes="(min-width: 1100px) 1100px, 100vw"
        loading="lazy"
      />
    </figure>
    <ServiceDirectory />
  </Section>

  <!-- 5. Proof. One job, shown rather than described, with the equipment that did
       it. Replaces three sections that were all making the same point. -->
  <Section
    index="04"
    label="Field record"
    tone="spruce"
    scale="display"
    weight="feature"
    heading="Proof of the work"
    intro="One job end to end, with the same detail you get on a quote."
    width="wide"
  >
    <BeforeAfter
      id="garage"
      before={baGarageBefore}
      after={baGarageAfter}
      beforeAlt="A two-car garage packed with cardboard boxes, storage totes, an old dresser and a bicycle, with no floor space visible"
      afterAlt="The same two-car garage completely empty with a clean swept concrete floor"
      caption="Drag to compare. Representative of a three-quarter load garage cleanout."
    />
    {featureJob && <div class="job"><ExampleJob job={featureJob} /></div>}
    <figure class="band proof-band">
      <Image
        src={imgProofLoaded}
        alt="Two workers closing the gate on a loaded trailer of old furniture, with a swept empty driveway behind"
        widths={[600, 1000, 1440]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        loading="lazy"
      />
      <figcaption class="data">The same job, loaded and away. One trailer, one trip.</figcaption>
    </figure>

    <div class="rigs">
      <EquipmentCapability variant="compact" />
    </div>
  </Section>

  <!-- 6. How it works. The original four steps, verbatim. A booking process on
       a homepage is for conversion clarity, not documentation: four steps can be
       taken in at a glance, where six read as a procedure. -->
  <Section index="05" label="Process" heading="How it works">
    <Image
      slot="media"
      src={imgQuotePhoto}
      alt="A hand holding a phone up to photograph a pile of furniture and boxes in a garage"
      widths={[420, 760]}
      sizes="(min-width: 900px) 42vw, 92vw"
      loading="lazy"
    />
    <HowItWorks variant="booking" />
  </Section>

  <!-- 7. Where we work. Real ZIP codes and plain anchors to every city, so the
       service-area relationships are crawlable without running the checker. -->
  <Section
    index="06"
    label="Service area"
    tone="sunk"
    scale="display"
    heading="Where we work"
    intro="Based in Mesa and working across the East Valley. Check a ZIP code or browse the list."
    width="wide"
    id="areas"
  >
    <figure class="band wide-band">
      <Image
        src={imgSuburb}
        alt="A quiet East Valley residential street of single storey stucco homes with tile roofs and gravel front yards"
        widths={[600, 1000, 1440]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        loading="lazy"
      />
    </figure>
    <ServiceAreaChecker />
  </Section>

  <!-- 8. Reviews. The section is built and positioned. It renders only when
       reviews.ts holds an entry with `verified: true` and a source, and there is
       currently no evidence any of the three stored testimonials came from a
       real customer: no date, no platform beyond "direct", no link, and all
       three first appeared in the commit that rebranded the starter template.
       Publishing them would be inventing social proof, so the section stays
       hidden until the business confirms them or supplies real ones. -->
  {
    showReviews && (
      <Section heading="What customers say" width="wide">
        <ReviewWall />
      </Section>
    )
  }
  {
    showTrust && (
      <Section weight="tight" heading="The checkable bits">
        <TrustFacts />
      </Section>
    )
  }

  <!-- 9. FAQ. Six questions with decision value, not a knowledge dump. -->
  <Section index="07" label="FAQ" scale="utility" heading="Common questions" width="wide">
    <FaqBlock faqs={homeFaqs} />
  </Section>

  <!-- 10. Convert. Nothing educational below this. -->
  <FinalQuoteCta
    heading="Send a few photos and get a real number"
    body="Most quotes come back the same day. Same-day pickup is often possible when you get in touch early and the job fits an existing route."
    source="home-final"
  />
</BaseLayout>

<style>
  /* The restored operating facts. A ruled row, not translucent pills over a
     gradient: same information, without the pattern that made the original hero
     read as generated. */
  .facts {
    background: var(--bone);
    border-bottom: 1px solid var(--rule);
  }

  .facts ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s3);
    padding-block: var(--s5);
  }

  .facts li {
    position: relative;
    padding-inline-start: var(--s5);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t3);
  }

  .facts li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 12px;
    height: 2px;
    background: var(--hi-vis);
  }

  @media (min-width: 700px) {
    .facts ul {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s5);
    }
  }

  /*
   * Image bands. A wide photograph carrying its own aspect ratio, used where a
   * section benefits from one visual anchor rather than an image beside every
   * block. Ratios vary deliberately so the page does not settle into one rhythm:
   * 16:9 for the proof band, 21:9 for the location band.
   */
  .band {
    margin: 0 0 var(--s6);
  }

  .band :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-flat);
  }

  .wide-band :global(img) {
    aspect-ratio: 21 / 9;
  }

  /* Full-bleed bands are ratio-driven, which is right on a phone and wrong on a
     desktop: 16/9 across a 1345px content width renders 756px tall, taller than
     the laptop viewport it is being viewed in, so the band stops reading as an
     image in a page and starts reading as an interstitial. Capping the height
     keeps the ratio on narrow screens and turns the band into a wider crop on
     large ones, which is the shape it wanted anyway. */
  @media (min-width: 1000px) {
    .band :global(img) {
      max-height: 420px;
      object-fit: cover;
    }

    .wide-band :global(img) {
      max-height: 380px;
    }
  }

  .proof-band {
    margin-top: var(--s7);
    margin-bottom: 0;
  }

  .proof-band figcaption {
    margin-top: var(--s3);
    font-size: var(--t3);
    color: var(--ink-2);
  }

  /* The pricing model, attached to the scale that produced the numbers. */
  .pricing-note {
    margin-top: var(--s8);
    padding-top: var(--s6);
    border-top: 2px solid var(--ink);
  }

  .pricing-note h3 {
    margin-bottom: var(--s4);
  }

  /* Contextual link out to a deeper page. Deliberately not a button: DESIGN.md
     reserves full-size CTAs for the two conversion actions, and one after every
     section is the CTA fatigue this restructure exists to avoid. */
  .section-link {
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
  }

  .section-link a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--spruce-2);
  }

  .section-link a::after {
    content: ' \2192';
  }

  .job {
    margin-top: var(--s7);
  }

  .rigs {
    margin-top: var(--s7);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
  }
</style>
