---
/**
 * Homepage — the complete 16-section build.
 *
 * Every section is an independently removable component fed from the knowledge
 * graph, which is the point of shipping the whole thing before pruning: the
 * system gets evaluated at full extent, then sections get cut or moved with real
 * evidence rather than guesses.
 *
 * WHAT CHANGED FROM THE OLD HOMEPAGE. It was six consecutive card grids on a
 * gradient hero, with three hardcoded testimonials, four hardcoded FAQs, and a
 * "Free quote" button pointing at /services. Nothing is hardcoded here: services,
 * cities, materials, situations, load sizes, pricing factors, disposal routes,
 * jobs and questions all come from src/data through src/lib/knowledge.ts.
 *
 * SECTIONS CURRENTLY HIDDEN, by design and not by omission:
 *   - Reviews. reviews.ts holds no verified entries, so ReviewWall renders
 *     nothing and the heading is suppressed with it. No placeholder ships.
 *   - Trust facts. VERIFIED in site.ts is empty, so no credential is claimed.
 * Both appear automatically once real data exists.
 *
 * LAYOUT DISCIPLINE. Nine distinct layout families across sixteen sections, no
 * family repeated, never three consecutive image-and-text splits, and three
 * micro-labels total against a budget of five.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import QuoteStarter from '../components/QuoteStarter.astro';
import WhatWeRemove from '../components/WhatWeRemove.astro';
import WhatWeDontRemove from '../components/WhatWeDontRemove.astro';
import ItemLookup from '../components/ItemLookup.astro';
import LoadSizeScale from '../components/LoadSizeScale.astro';
import PricingLedger from '../components/PricingLedger.astro';
import Situations from '../components/Situations.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ExampleJob from '../components/ExampleJob.astro';
import EquipmentCapability from '../components/EquipmentCapability.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import ReviewWall from '../components/ReviewWall.astro';
import ComparisonLedger from '../components/ComparisonLedger.astro';
import DisposalFlow from '../components/DisposalFlow.astro';
import FaqBlock from '../components/FaqBlock.astro';
import RelatedRail from '../components/RelatedRail.astro';
import FinalQuoteCta from '../components/FinalQuoteCta.astro';
import TrustFacts from '../components/TrustFacts.astro';

import { SITE } from '../config/site';
import { services } from '../data/services';
import { getJob } from '../data/jobs';
import { hasVerifiedReviews } from '../data/reviews';
import { hasVerifiedFacts } from '../config/site';
import { featuredFaqs, faqsForTopic, globalFaqs } from '../data/faqs';
import { serviceUrl } from '../lib/urls';

import baGarageBefore from '../assets/photos/before-after/ba-garage-before.jpg';
import baGarageAfter from '../assets/photos/before-after/ba-garage-after.jpg';

/** The homepage question set: high-intent first, then the topic banks. */
const homeFaqs = [
  ...featuredFaqs(),
  ...faqsForTopic('pricing').filter((f) => !f.featured),
  ...globalFaqs().filter((f) => !f.featured),
]
  .filter((faq, i, all) => all.findIndex((f) => f.slug === faq.slug) === i)
  .slice(0, 10)
  .map((f) => ({ question: f.question, answer: f.answer }));

const featureJob = getJob('gilbert-garage-reset');

const serviceLinks = services.map((s) => ({
  label: s.name,
  href: serviceUrl(s.slug),
  description: s.tagline,
}));

const showReviews = hasVerifiedReviews();
const showTrust = hasVerifiedFacts();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- 1. Hero. Full-bleed photograph, four text elements, both CTAs. -->
  <Hero
    eyebrow="Mesa and the East Valley"
    heading="Point at it. We carry it out."
    subhead="Furniture, appliances, garages, estates and construction debris. You get the price before anything is loaded."
    alt="Two workers carrying a large sofa out through an open garage door and down a driveway"
  />

  <!-- 2. Quote starter. A tight action strip, not a section of content. -->
  <Section weight="tight" tone="sunk" id="start">
    <QuoteStarter />
  </Section>

  <!-- 3. What we remove. Typographic index. -->
  <Section
    label="What we take"
    heading="80 things we take. And 8 we won't."
    intro="Grouped by what they are, with the conditions that apply. The full searchable list is right below."
  >
    <WhatWeRemove />
  </Section>

  <!-- 3b. The exclusions, and the item lookup. Same topic, different families. -->
  <Section weight="standard" tone="sunk" heading="What we cannot take">
    <WhatWeDontRemove />
  </Section>

  <Section heading="Can we take yours?" width="wide" id="can-we-take">
    <ItemLookup />
  </Section>

  <!-- 4. Load size. The signature component, given feature weight. -->
  <Section
    weight="feature"
    label="How much have you got"
    heading="Work out your load size"
    intro="Price is mostly about how much of the trailer you fill. Find the closest match and you are already most of the way to a real number."
    width="wide"
  >
    <LoadSizeScale />
  </Section>

  <!-- 5. Pricing. Ledger. -->
  <Section
    tone="sunk"
    heading="How pricing works"
    intro="No published price list, because volume, weight and access vary too much for one to be honest. Here is exactly what the number is built from."
    width="wide"
  >
    <PricingLedger />
  </Section>

  <!-- 6. Situations. Alternating editorial splits, capped at four. -->
  <Section
    heading="Why people call"
    intro="Nobody wakes up wanting junk removal. They want a garage back, a house listed, or an estate settled."
  >
    <Situations />
  </Section>

  <!-- 7. Before and after. Feature weight, full width. -->
  <Section
    weight="feature"
    heading="A two-car garage, cleared"
    width="wide"
  >
    <BeforeAfter
      id="garage"
      before={baGarageBefore}
      after={baGarageAfter}
      beforeAlt="A two-car garage packed with cardboard boxes, storage totes, an old dresser and a bicycle, with no floor space visible"
      afterAlt="The same two-car garage completely empty with a clean swept concrete floor"
      caption="Drag to compare. Representative of a three-quarter load garage cleanout."
    />
  </Section>

  <!-- 8. Example job. A single record, not a grid of them. -->
  <Section
    tone="sunk"
    heading="What a job actually looks like"
    intro="Every number here is the kind of detail you get on a quote: how much space, how many people, how long, and where it all ended up."
  >
    {featureJob && <ExampleJob job={featureJob} />}
  </Section>

  <!-- 9. Equipment. Asymmetric, with the honest capacity constraint. -->
  <Section
    heading="What we haul with"
    intro="Two trailers for two different problems, and one truck, which is why a big job is planned as several trips rather than discovered halfway through the day."
    width="wide"
  >
    <EquipmentCapability />
  </Section>

  <!-- 10. Process. Numbered ledger. -->
  <Section
    label="Start to finish"
    heading="How it works"
    intro="Eight steps, including the three that happen after we drive away."
  >
    <HowItWorks />
  </Section>

  <!-- 11. Areas served, with the ZIP checker. -->
  <Section
    tone="sunk"
    heading="Do we come to you?"
    intro="Based in Mesa, working across the East Valley. Check a ZIP or browse the list."
    width="wide"
    id="areas"
  >
    <ServiceAreaChecker />
  </Section>

  <!-- 12. Reviews. Hidden entirely until verified reviews exist. -->
  {
    showReviews && (
      <Section heading="What customers say">
        <ReviewWall />
      </Section>
    )
  }

  <!-- 12b. Verified credentials. Hidden until any exist. -->
  {
    showTrust && (
      <Section weight="tight" heading="The checkable bits">
        <TrustFacts />
      </Section>
    )
  }

  <!-- 13. DIY comparison, including when to not call us. -->
  <Section
    heading="Should you just rent a truck?"
    intro="Sometimes, genuinely. Here is how the two actually compare."
    width="wide"
  >
    <ComparisonLedger slug="diy-vs-full-service" />
  </Section>

  <!-- 14. Disposal. -->
  <Section
    tone="sunk"
    heading="Where it goes after it leaves"
    intro="Sorted in this order, every load. What decides where something ends up is its condition, not our marketing."
  >
    <DisposalFlow />
  </Section>

  <!-- 15. FAQs. Two-column list above 768px, collapsed below. -->
  <Section heading="Questions people ask first" width="wide">
    <FaqBlock faqs={homeFaqs} />
  </Section>

  <!-- 15b. Service navigation as a designed rail, replacing the old link grid. -->
  <Section weight="tight" tone="sunk">
    <RelatedRail title="All services" links={serviceLinks} variant="index" />
  </Section>

  <!-- 16. Final CTA. -->
  <FinalQuoteCta
    heading="Send a few photos and get a real number"
    body="Most quotes come back the same day. Same-day pickup is often possible when you get in touch early and the job fits an existing route."
    source="home-final"
  />
</BaseLayout>
