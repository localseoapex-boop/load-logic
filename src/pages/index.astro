---
/**
 * Homepage — nine sections, restructured around Understand, Trust, Estimate, Convert.
 *
 * The complete build was eighteen sections and 25,857px at 390px, about 31
 * screens. That was deliberate: build everything, see the whole system, then cut
 * with evidence. This is the cut.
 *
 * ─────────────── What the homepage is now responsible for ───────────────
 *
 * Answering, in order, quickly enough that a homeowner can scan it one-handed:
 * what Load Logic does, whether they take your thing, how much you have, how
 * pricing works, why people call, that the work is real, what happens next,
 * where they operate, and how to ask.
 *
 * It is NOT responsible for displaying the knowledge graph. Depth now lives on
 * /pricing, the service pages, the location pages and /knowledge.json, and the
 * homepage routes intent to them through ordinary crawlable links.
 *
 * ─────────────────────── What that means for SEO ───────────────────────
 *
 * The entity relationships a crawler or an assistant needs are all still stated
 * in the HTML: the business, its services, the material categories it handles,
 * its service area with real ZIP codes, its pricing model, its equipment and its
 * quote action. Every service and every city keeps a plain anchor.
 *
 * The homepage no longer lists all 88 individual materials. That inventory is
 * business knowledge rather than homepage content: it lives in the graph, in
 * /knowledge.json and on the pages that own each material relationship. What the
 * homepage states is the category level, which is what a person and an assistant
 * both need in order to know whether to keep reading.
 *
 * Headings name their subject in plain language, so the page structure reads the
 * same way to a person and to a parser.
 *
 * MERGED:   item categories + search + exclusions -> one overview section
 *           before/after + example job + equipment -> one proof section
 *           situations + service directory        -> one navigation section
 *           disposal                              -> final step of How it works
 * REMOVED:  the DIY comparison, the standalone quote strip, the standalone
 *           service rail, the standalone exclusions and disposal sections.
 *           Every one of those components still exists and stays reusable.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import MaterialOverview from '../components/MaterialOverview.astro';
import LoadSizeScale from '../components/LoadSizeScale.astro';
import PricingLedger from '../components/PricingLedger.astro';
import Situations from '../components/Situations.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ExampleJob from '../components/ExampleJob.astro';
import EquipmentCapability from '../components/EquipmentCapability.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import ReviewWall from '../components/ReviewWall.astro';
import TrustFacts from '../components/TrustFacts.astro';
import FaqBlock from '../components/FaqBlock.astro';
import RelatedRail from '../components/RelatedRail.astro';
import FinalQuoteCta from '../components/FinalQuoteCta.astro';

import { SITE, hasVerifiedFacts } from '../config/site';
import { services } from '../data/services';
import { getJob } from '../data/jobs';
import { hasVerifiedReviews } from '../data/reviews';
import { getFaq } from '../data/faqs';
import { serviceUrl } from '../lib/urls';

import baGarageBefore from '../assets/photos/before-after/ba-garage-before.jpg';
import baGarageAfter from '../assets/photos/before-after/ba-garage-after.jpg';

/**
 * Six questions, chosen for decision value rather than coverage: price, what is
 * taken, how a quote works, timing, heavy material, and whether anything has to
 * be moved outside first. Everything else belongs on the page that owns it.
 */
const homeFaqs = [
  'how-is-pricing-determined',
  'what-do-you-not-take',
  'can-i-send-photos',
  'how-quickly-can-you-come',
  'do-you-take-heavy-material',
  'do-i-need-to-move-things-outside',
]
  .map(getFaq)
  .filter((f): f is NonNullable<typeof f> => Boolean(f))
  .map((f) => ({ question: f.question, answer: f.answer }));

const featureJob = getJob('gilbert-garage-reset');

/** Every service keeps a crawlable anchor, integrated rather than in its own block. */
const serviceLinks = services.map((s) => ({ label: s.name, href: serviceUrl(s.slug) }));

const showReviews = hasVerifiedReviews();
const showTrust = hasVerifiedFacts();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- 1. Hero. Four text elements, both CTAs, no explanatory copy above the fold. -->
  <Hero
    eyebrow="Junk removal in Mesa and the East Valley"
    heading="Point at it. We carry it out."
    subhead="Send a few photos and get a price. Nothing is loaded until you agree to the number."
    alt="Two workers carrying a large sofa out through an open garage door and down a driveway"
  />

  <!-- 2. Discovery. Eight categories with recognisable examples, answering
       "do they take my kind of stuff" in a few seconds and then moving on. The
       full 88-item catalogue stays in the knowledge graph and in
       /knowledge.json rather than on the homepage. -->
  <Section
    tone="sunk"
    heading="What do you need gone?"
    intro="If it fits on the trailer and it is legal to haul, it goes. Here is the shape of it."
    id="what-we-take"
  >
    <MaterialOverview />
  </Section>

  <!-- 3. Load size. The strongest reason someone can answer their own question
       before contacting anyone. -->
  <Section
    weight="feature"
    heading="How much junk do you have?"
    intro="Price is mostly the share of the trailer you fill. Find the closest match and you already have a range."
    width="wide"
  >
    <LoadSizeScale />
  </Section>

  <!-- 4. Pricing. The model only. The detail is one link away. -->
  <Section tone="sunk" heading="How junk removal pricing works">
    <PricingLedger variant="brief" />
    <p class="section-link">
      <a href="/pricing">Every pricing factor, worked examples and the do-it-yourself comparison</a>
    </p>
  </Section>

  <!-- 5. Why people call, then the services those situations map to. Problem-led
       discovery and service-topic internal linking in one section. -->
  <Section
    heading="Why people call, and what they book"
    intro="Nobody wakes up wanting junk removal. They want a garage back, a house listed, or an estate settled."
  >
    <Situations variant="navigator" />
    <div class="directory">
      <RelatedRail
        title="Junk removal services"
        links={serviceLinks}
        variant="index"
        headingLevel="h3"
      />
    </div>
  </Section>

  <!-- 6. Proof. One job, shown rather than described, with the equipment that did
       it. Replaces three sections that were all making the same point. -->
  <Section
    tone="sunk"
    weight="feature"
    heading="Proof of the work"
    intro="One job end to end, with the same detail you get on a quote."
    width="wide"
  >
    <BeforeAfter
      id="garage"
      before={baGarageBefore}
      after={baGarageAfter}
      beforeAlt="A two-car garage packed with cardboard boxes, storage totes, an old dresser and a bicycle, with no floor space visible"
      afterAlt="The same two-car garage completely empty with a clean swept concrete floor"
      caption="Drag to compare. Representative of a three-quarter load garage cleanout."
    />
    {featureJob && <div class="job"><ExampleJob job={featureJob} /></div>}
    <div class="rigs">
      <EquipmentCapability variant="compact" />
    </div>
  </Section>

  <!-- 7. How it works. Six steps, ending with where the material goes, which is
       why disposal no longer needs a section of its own. -->
  <Section heading="How it works">
    <HowItWorks variant="compact" />
  </Section>

  <!-- 8. Where we work. Real ZIP codes and plain anchors to every city, so the
       service-area relationships are crawlable without running the checker. -->
  <Section
    tone="sunk"
    heading="Where we work"
    intro="Based in Mesa and working across the East Valley. Check a ZIP code or browse the list."
    width="wide"
    id="areas"
  >
    <ServiceAreaChecker />
  </Section>

  <!-- Hidden until verified data exists. No placeholder ships. -->
  {
    showReviews && (
      <Section heading="What customers say">
        <ReviewWall />
      </Section>
    )
  }
  {
    showTrust && (
      <Section weight="tight" heading="The checkable bits">
        <TrustFacts />
      </Section>
    )
  }

  <!-- 9. FAQ. Six questions with decision value, not a knowledge dump. -->
  <Section heading="Common questions" width="wide">
    <FaqBlock faqs={homeFaqs} />
  </Section>

  <!-- 10. Convert. Nothing educational below this. -->
  <FinalQuoteCta
    heading="Send a few photos and get a real number"
    body="Most quotes come back the same day. Same-day pickup is often possible when you get in touch early and the job fits an existing route."
    source="home-final"
  />
</BaseLayout>

<style>
  /* Contextual link out to a deeper page. Deliberately not a button: DESIGN.md
     reserves full-size CTAs for the two conversion actions, and one after every
     section is the CTA fatigue this restructure exists to avoid. */
  .section-link {
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
  }

  .section-link a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--spruce-2);
  }

  .section-link a::after {
    content: ' \2192';
  }

  /* The service directory sits under the situations that lead to it, so the two
     read as one navigation moment rather than two competing blocks. */
  .directory {
    margin-top: var(--s7);
    padding-top: var(--s6);
    border-top: 2px solid var(--ink);
  }

  .job {
    margin-top: var(--s7);
  }

  .rigs {
    margin-top: var(--s7);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
  }
</style>
