---
/**
 * /quote — the destination for the site's primary CTA.
 *
 * On the old site "Get a free quote" and the mobile "Free quote" button both
 * pointed at /services, so the primary conversion action did not exist. This is
 * the page it should always have gone to.
 *
 * A NEW URL, not a changed one. Nothing existing moves, so the 175 baseline URLs
 * are untouched and no redirect is required.
 *
 * `noindex` is deliberate: a bare form page competes with nothing in search and
 * has no content worth ranking. The conversion value is in getting people here
 * from pages that do rank.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { BUSINESS } from '../config/site';

/**
 * Worded for this page, so it answers the two questions someone has with their
 * thumb over the button: who gets back to me, and can the price still move.
 * Deliberately NOT `quoteAction.nextSteps`, which is the site-wide four-step
 * version still rendered on /quote/thanks, the homepage and /pricing.
 */
const nextSteps = [
  'We review your request and confirm we cover your area.',
  'We call or text you with an estimate and available pickup times.',
  'The crew confirms the final price before anything is loaded.',
];
---

<BaseLayout
  title="Get a Photo Quote"
  description="Send photos of what needs to go and get an estimate back, usually the same day. Junk removal across Mesa and the East Valley."
  noindex
  hideActionBar
>
  <div class="quote-page">
    <div class="container">
      <header class="head">
        <h1>Get your quote</h1>
        <p class="lede">Tell us what you need removed. Photos help, but they're not required.</p>
      </header>

      <div class="layout">
        <div class="form-col">
          <QuoteForm />
        </div>

        <aside class="rail">
          <section>
            <h2>What happens next</h2>
            <ol>
              {nextSteps.map((step) => <li>{step}</li>)}
            </ol>
          </section>

          <p class="tip">
            Photo tip: One wide shot of everything, plus the path to where we can
            park.
          </p>

          <section>
            <h2>Prefer to call or text?</h2>
            <p class="call-copy">
              Call us or text photos to
              <a class="data" href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>.
            </p>
            <div class="call-actions">
              <a class="call" href={`tel:${BUSINESS.phone}`}>Call Now</a>
              <a class="text" href={`sms:${BUSINESS.phone}`}>Text Us</a>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ─── The quote surface ───
     Off-white rather than page white, so the form card reads as the object on
     top of it. The hairline grid is the site's field-record register drawn in
     CSS: two sets of 1px steel lines at 5% over the alt surface, no gradient
     wash and no image. At this strength it registers as paper texture from a
     normal viewing distance, not as a pattern competing with the form. */
  .quote-page {
    padding-block: var(--s7) var(--s9);
    background-color: var(--surface-alt);
    background-image:
      repeating-linear-gradient(90deg, rgb(105 112 119 / 0.05) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, rgb(105 112 119 / 0.05) 0 1px, transparent 1px 72px);
    border-bottom: 1px solid var(--rule);
  }

  .head {
    max-width: 40ch;
    margin-bottom: var(--s6);
  }

  /* The accent as a mark above the heading, which is how the rest of the site
     carries it in type: a rule, never coloured words. */
  .head::before {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    margin-bottom: var(--s4);
    background: var(--accent);
  }

  .lede {
    margin-top: var(--s3);
    font-size: var(--t1);
    color: var(--ink-2);
  }

  .layout {
    display: grid;
    gap: var(--s8);
    align-items: start;
  }

  /* ─── Supporting panel ───
     Deliberately not a second card. On the off-white surface it is held
     together by hairlines and space alone, so the white form card is the only
     object with weight and the eye goes there first. */
  .rail {
    display: grid;
    gap: var(--s5);
    padding-inline-start: var(--s5);
    border-inline-start: 1px solid var(--rule-strong);
  }

  .rail h2 {
    font-size: var(--t1);
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: var(--s4);
  }

  .rail ol {
    counter-reset: step;
    list-style: none;
    padding: 0;
    display: grid;
  }

  /* Hairline between steps, so the sequence is legible as three stages rather
     than a paragraph broken into three. */
  .rail ol li {
    counter-increment: step;
    position: relative;
    padding-block: var(--s3);
    padding-inline-start: var(--s6);
    font-size: var(--t3);
    color: var(--ink-2);
    border-top: 1px solid var(--rule);
  }

  .rail ol li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .rail ol li:last-child {
    padding-bottom: 0;
  }

  /* The numeral is the marker, in the site's operational mono at full ink
     strength: it has to be readable, and orange numerals this size would not
     clear AA on the surface behind them. */
  .rail ol li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 0;
    font-family: var(--font-data);
    font-weight: 600;
    color: var(--ink);
  }

  /* One line, not a list: the only photo guidance that is not obvious from
     standing in front of the pile. */
  .tip {
    position: relative;
    padding-inline-start: var(--s5);
    font-size: var(--t3);
    color: var(--ink-2);
  }

  .tip::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7em;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  .call-copy {
    font-size: var(--t3);
    color: var(--ink-2);
    margin-bottom: var(--s4);
  }

  .call-copy a {
    font-weight: 600;
  }

  /* Both actions are real links, so texting is one tap rather than a number to
     copy out by hand. */
  .call-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  .call,
  .text {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--s5);
    border-radius: var(--r);
    font-family: var(--font-text);
    font-weight: 600;
    text-decoration: none;
  }

  .call {
    background: var(--dark);
    color: #fff;
  }

  .text {
    border: 1px solid var(--rule-strong);
    color: var(--ink);
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--s9);
    }

    .rail {
      position: sticky;
      top: calc(64px + var(--s5));
    }
  }
</style>
