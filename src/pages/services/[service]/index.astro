---
/**
 * /services/[service] — one page per service category.
 *
 * getStaticPaths() fans out over the services catalog. Add a category to
 * data/services.ts, register its photography in data/service-images.ts, and its
 * page appears automatically.
 *
 * ─────────────── The rollout scaffolding is gone ───────────────
 *
 * While the redesign was landing service by service, this route rendered the old
 * ServiceLayout and each migrated service had its own static route file. That
 * existed for one reason: a route importing both templates ships both
 * stylesheets, because Astro decides a page's CSS from its module graph rather
 * than from which template renders, and legacy.css then reached into the new
 * layout.
 *
 * All fourteen have migrated, so there is nothing left to keep apart. This route
 * imports only ServiceLayout2026, the per-service files are deleted, and no
 * service page loads legacy.css.
 *
 * legacy.css itself stays: the location templates, the sub-service template and
 * the blog still depend on it.
 */
import ServiceLayout2026 from '../../../layouts/ServiceLayout2026.astro';
import { services } from '../../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<ServiceLayout2026 {service} />
