---
/**
 * /services — hub page listing every service.
 *
 * Acts as the breadcrumb parent for service pages and a crawl hub that links to
 * all of them, helping search engines discover the full set.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IndexHero from '../../components/IndexHero.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import heroImg from '../../assets/photos/home/hero-carry.jpg';
import { services } from '../../data/services';
import { serviceUrl } from '../../lib/urls';

const links = services.map((s) => ({
  label: s.name,
  href: serviceUrl(s.slug),
  description: s.tagline,
}));
---

<BaseLayout
  title="Junk Removal & Cleanout Services"
  description="Explore Load Logic's full range of junk removal and cleanout services across Mesa and the East Valley — furniture, appliances, garages, estates, and more."
>
  <div class="container container-wide crumbs">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Services' }]} />
  </div>

  {/* Compact index masthead — see IndexHero.astro. Browsing page: no hero CTA,
      the service directory below carries the links. */}
  <IndexHero
    eyebrow="All services"
    heading="Junk Removal Services"
    lede="Junk removal, cleanouts and hauling for homes and businesses across the East Valley. Every service below is full-service: we bring the truck and the muscle, you point at what goes."
    image={heroImg}
    focus="center 42%"
  />

  <div class="container page">
    <InternalLinks title="Browse services" links={links} />
  </div>
</BaseLayout>

<style>
  .crumbs {
    padding-top: var(--s5);
    padding-bottom: var(--s4);
  }

  .page {
    padding-block: var(--s7) var(--s8);
  }
</style>
