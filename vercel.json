{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/locations/:city/:service/:subservice",
      "destination": "/services/:service/:subservice",
      "permanent": true
    },
    {
      "source": "/locations/:city/:service",
      "destination": "/services/:service",
      "permanent": true
    }
  ]
}
