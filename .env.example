# Quote form backend. See docs/quote-form-backend.md.
# Copy to .env for local development. Never commit real values.

# Required. Resend API key; sends the lead notification.
RESEND_API_KEY=

# Required for photo uploads. Created with the project's Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional. Must be an address on a domain verified in Resend.
# Defaults to Resend's sandbox sender, which only delivers to the account owner.
# QUOTE_FROM_EMAIL="Load Logic Quotes <quotes@loadlogicjr.com>"

# Optional. Defaults to loadlogicjr@gmail.com.
# QUOTE_TO_EMAIL=loadlogicjr@gmail.com
